<?xml version="1.0" encoding="utf-8"?>
<!--
  MegaPodcastPlayer launcher icon, foreground layer.

  A ball microphone in its yoke, with cat ears — the "pod" and the "cat" in one mark.

  Adaptive-icon geometry: the layer is 108x108dp but launchers only show the centre 72dp and may
  mask it to any shape, so every path stays inside the 66dp safe circle (x and y in 21..87).

  Two things are deliberate at launcher size, where the whole mark is ~15px tall:
   * the capsule is a circle rather than the usual tall pill, because ears on a pill read as a
     funnel or a rocket rather than as a head;
   * the ears lean outwards and their inner edges meet the head near its crown, leaving a narrow V
     of background between them. Without that notch the two triangles merge into one spike.

  A single flat fill is used throughout, which also lets this drawable serve as the `monochrome`
  layer for themed icons — the system re-tints it and only the alpha matters.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left ear. Drawn before the head so the seam where they meet disappears. -->
    <path
        android:fillColor="#FFB868"
        android:pathData="M42.5,42 L44.5,27 L53,35 Z" />

    <!-- Right ear, mirrored about x=54. -->
    <path
        android:fillColor="#FFB868"
        android:pathData="M65.5,42 L63.5,27 L55,35 Z" />

    <!-- Head / microphone capsule: a circle of radius 12.5 centred at (54,47), sized to clear the yoke arms. -->
    <path
        android:fillColor="#FFB868"
        android:pathData="M54,34.5 C60.904,34.5 66.5,40.096 66.5,47 C66.5,53.904 60.904,59.5 54,59.5 C47.096,59.5 41.5,53.904 41.5,47 C41.5,40.096 47.096,34.5 54,34.5 Z" />

    <!-- Yoke: the U-shaped cradle under the capsule. Stroked rather than filled so it stays thin. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M36,55 C36,64 44,70.5 54,70.5 C64,70.5 72,64 72,55"
        android:strokeColor="#FFB868"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Stem joining the yoke to the base. -->
    <path
        android:fillColor="#FFB868"
        android:pathData="M51.5,69 L56.5,69 L56.5,76 L51.5,76 Z" />

    <!-- Base: a 22x5.5 rounded bar. -->
    <path
        android:fillColor="#FFB868"
        android:pathData="M45.75,74.5 L62.25,74.5 C63.77,74.5 65,75.73 65,77.25 C65,78.77 63.77,80 62.25,80 L45.75,80 C44.23,80 43,78.77 43,77.25 C43,75.73 44.23,74.5 45.75,74.5 Z" />
</vector>
