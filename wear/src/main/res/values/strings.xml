<?xml version="1.0" encoding="utf-8"?>
<!--
    Copy for the watch app.

    Watch copy has a hard constraint the phone does not: a Wear screen fits roughly four short
    lines, so every string here is deliberately one clause. Keep translations equally short rather
    than equally literal.

    The playback time and speed labels (`1:04:12`, `1.5x`) stay in Kotlin — see `Durations.kt`.
    They are numeric formats rather than copy, and they are unit-tested without a Context.
-->
<resources>

    <string name="app_name">BPodcat</string>

    <string name="watch_up_next">Up next</string>

    <string name="watch_play">Play</string>
    <string name="watch_pause">Pause</string>
    <string name="watch_previous_episode">Previous episode</string>
    <string name="watch_next_episode">Next episode</string>

    <!-- TalkBack labels for the skip buttons; the glyph carries the number visually. -->
    <plurals name="watch_skip_forward">
        <item quantity="one">Skip ahead %1$d second</item>
        <item quantity="other">Skip ahead %1$d seconds</item>
    </plurals>
    <plurals name="watch_skip_back">
        <item quantity="one">Skip back %1$d second</item>
        <item quantity="other">Skip back %1$d seconds</item>
    </plurals>

    <!-- The progress bar doubles as a scrubber; these name it for TalkBack in each of its modes. -->
    <string name="watch_scrub">Playback position. Tap to adjust</string>
    <string name="watch_scrub_active">Adjusting position. Turn the bezel, then tap to confirm</string>

    <string name="watch_buffering">Buffering</string>

    <string name="watch_nothing_playing_title">Nothing playing</string>
    <string name="watch_nothing_playing_with_queue">Pick an episode below to start it on your phone.</string>
    <string name="watch_nothing_playing_empty">Start an episode on your phone and it will show up here.</string>

    <string name="watch_command_failed">Could not reach your phone</string>

    <string name="watch_link_checking_title">Looking for your phone</string>
    <string name="watch_link_checking_description">One moment.</string>
    <string name="watch_link_app_missing_title">BPodcat is not on your phone</string>
    <string name="watch_link_app_missing_description">Install BPodcat on your phone to control it from here.</string>
    <string name="watch_link_disconnected_title">Phone not connected</string>
    <string name="watch_link_disconnected_description">Bring your phone closer, or turn Bluetooth back on.</string>

    <string name="watch_retry">Retry</string>

    <!--
      Episodes carried over to the watch itself. This is the one part of the app that works with the
      phone out of range, so its copy says "on this watch" rather than naming the phone at all.
    -->
    <string name="watch_on_this_watch">On this watch</string>
    <string name="watch_copy_to_watch">Copy to watch</string>
    <string name="watch_copying">Copying…</string>
    <string name="watch_remove_from_watch">Remove from watch</string>
    <string name="watch_free_up_space">Remove all from watch</string>
    <string name="watch_nothing_to_copy">Download an episode on your phone to copy it here.</string>
    <string name="watch_playing_on_watch">Playing on this watch</string>
    <!-- Second line of a stored row: the show, and how far through it the wearer is. -->
    <string name="watch_stored_remaining">%1$s · %2$s left</string>
    <string name="watch_stored_played">%1$s · Played</string>
    <string name="watch_back_to_phone">Back to the phone</string>
    <string name="watch_phone_out_of_range">Phone out of range. Episodes on this watch still play.</string>
    <!-- Stands in for a title when audio arrives without the offer that described it. -->
    <string name="watch_unknown_episode">Episode</string>

    <!--
      The tile, one swipe from the watch face. Its skip labels are deliberately unnumbered: the tile
      is built before the phone's configured interval is known, and a button that said "30" while
      the phone jumps 45 would be a small lie pressed daily.
    -->
    <string name="watch_tile_label">Now playing</string>
    <string name="watch_tile_idle_body">Start an episode on your phone.</string>
    <string name="watch_tile_skip_back">Skip back</string>
    <string name="watch_tile_skip_forward">Skip ahead</string>

    <!--
      The complication, on the watch face itself. It gets about four characters, so `empty` is a
      dash rather than a sentence; the description is what TalkBack reads instead.
    -->
    <string name="watch_complication_label">Now playing</string>
    <string name="watch_complication_empty">—</string>
    <string name="watch_complication_description">%1$s, %2$s</string>
    <!-- Shown in the complication picker, before the watch has asked the phone anything. -->
    <string name="watch_complication_preview_episode">The one about batteries</string>
    <string name="watch_complication_preview_show">Radio Hardware</string>

    <!--
      The watch-face chip. The channel name is what the user sees in the system's notification
      settings, so it names the thing rather than the mechanism.
    -->
    <string name="watch_ongoing_channel_name">Now playing</string>
    <string name="watch_ongoing_channel_description">Keeps playback controls on your watch face while an episode is playing.</string>
    <string name="watch_ongoing_status">Playing on your phone</string>

</resources>
