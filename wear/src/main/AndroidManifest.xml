<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Keeps playback controls reachable from the watch face via an OngoingActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The end-of-episode bell, which reaches a sleeping wearer through the wrist and not the ear. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      No backup. The watch keeps nothing of its own worth carrying to a new device: everything it
      shows is the phone's, replayed from the Data Layer the moment the two are paired again.

      No right-to-left either, in step with the phone (DS-8, D-5). Nothing here would break if it
      were mirrored — there are no swipe rows on the watch — but two halves of one app, installed
      from one build, should not disagree about which reading directions they support. The reasoning
      is in app/src/main/AndroidManifest.xml.
    -->
    <application
        android:name=".WearApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.MegaPodcastPlayer.Wear">

        <!--
          The watch app is useless without the phone (it is a remote control), but it is still
          declared standalone=false rather than requiring the Play Store pairing flow, because it is
          sideloaded.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@style/Theme.MegaPodcastPlayer.Wear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Keeps the watch-face chip in step with the phone. Play Services binds this - starting the
          watch app's process if necessary - when the phone publishes playback state, which is what
          lets the chip stay correct while the app itself is closed. It also listens for the phone
          app's capability, so the chip can be cleared when the phone goes out of range and no
          further data item can arrive to correct it.
        -->
        <service
            android:name=".ongoing.NowPlayingChipService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/megapodcastplayer" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/megapodcastplayer_phone_player" />
            </intent-filter>
        </service>

        <!--
          Buzzes the wrist when the phone's end-of-episode bell rings. Play Services starts this -
          and the watch app's process - when the message arrives, which is the whole point: the
          wearer is asleep and nothing of ours has been running for hours.
        -->
        <service
            android:name=".alert.BellReceiverService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/megapodcastplayer/bell" />
            </intent-filter>
        </service>

        <!--
          The now-playing tile. The permission is the system's own: only the tile host may bind
          this, which is why it can be exported without being reachable by any other app.
        -->
        <service
            android:name=".tile.NowPlayingTileService"
            android:exported="true"
            android:icon="@drawable/ic_ongoing_playing"
            android:label="@string/watch_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_ongoing_playing" />
        </service>

        <!--
          The watch-face complication. UPDATE_PERIOD_SECONDS is zero on purpose: a periodic refresh
          would wake this up to redraw something that had not changed, and every change it *could*
          draw arrives as a data item, which NowPlayingChipService turns into a push.
        -->
        <service
            android:name=".complication.NowPlayingComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_ongoing_playing"
            android:label="@string/watch_complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT,MONOCHROMATIC_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

    </application>

</manifest>
