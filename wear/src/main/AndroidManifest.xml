<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Keeps playback controls reachable from the watch face via an OngoingActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Playing an episode the watch holds, with the screen off and the phone at home. The media
      playback type is what lets that service keep running while the wrist is down.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      No backup. What the watch keeps of its own is episode audio the phone sent it and how far
      through each one the wearer got — tens of megabytes that would be pointless to back up and are
      replaceable in one tap, and positions that are reported back to the phone anyway.
    -->
    <application
        android:name=".WearApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BPodcat.Wear">

        <!--
          The watch app is useless without the phone (it is a remote control), but it is still
          declared standalone=false rather than requiring the Play Store pairing flow, because it is
          sideloaded.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@style/Theme.BPodcat.Wear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Keeps the watch-face chip in step with the phone. Play Services binds this - starting the
          watch app's process if necessary - when the phone publishes playback state, which is what
          lets the chip stay correct while the app itself is closed. It also listens for the phone
          app's capability, so the chip can be cleared when the phone goes out of range and no
          further data item can arrive to correct it.
        -->
        <service
            android:name=".ongoing.NowPlayingChipService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bpodcat" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bpodcat_phone_player" />
            </intent-filter>
        </service>
        <!--
          Receives an episode's audio from the phone. Play Services starts this - and with it the
          watch app's process - when the phone opens the channel, which is what lets a transfer
          begin while the app is closed and finish while it stays closed.
        -->
        <service
            android:name=".data.EpisodeAudioReceiverService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bpodcat/episode_audio" />
            </intent-filter>
        </service>

        <!--
          The watch's own player, for episodes it holds. A MediaSessionService rather than a player
          owned by the screen: the audio has to survive the wrist dropping, and a Bluetooth headset's
          buttons have to reach it.

          exported="true" is required by Media3 - the system's media controls bind the session from
          outside the app - and lint's ExportedService check wants a permission on it that no system
          surface would hold. Access control lives in the session's onConnect instead, which rejects
          every controller that is not this app or the system. Suppressed here, next to the reason,
          exactly as :core:media does for the phone's player.
        -->
        <service
            android:name=".playback.WatchPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          The now-playing tile. The permission is the system's own: only the tile host may bind
          this, which is why it can be exported without being reachable by any other app.
        -->
        <service
            android:name=".tile.NowPlayingTileService"
            android:exported="true"
            android:icon="@drawable/ic_ongoing_playing"
            android:label="@string/watch_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_ongoing_playing" />
        </service>

        <!--
          The watch-face complication. UPDATE_PERIOD_SECONDS is zero on purpose: a periodic refresh
          would wake this up to redraw something that had not changed, and every change it *could*
          draw arrives as a data item, which NowPlayingChipService turns into a push.
        -->
        <service
            android:name=".complication.NowPlayingComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_ongoing_playing"
            android:label="@string/watch_complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT,MONOCHROMATIC_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

    </application>

</manifest>
