<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      New-episode notifications, posted by the periodic refresh (see sync/RefreshWorker).

      The two foreground services keep running without it — the platform never blocks a foreground
      service for want of this permission — but denying it hides their notifications, which for the
      player means no transport controls in the shade or on the lock screen. That is why it is asked
      for on first launch rather than behind the refresh setting; see ui/NotificationPermissionEffect.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Playback and download foreground services. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Resume interrupted downloads after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Playback reaches hosts we do not choose, some of which are still cleartext-only; see
      network_security_config.xml for why that is allowed and what limits it.

      Backup is on deliberately: a re-installed or replaced phone should come back with the user's
      subscriptions and listening positions. What travels and what does not is decided in
      data_extraction_rules.xml, which is the file to read before changing allowBackup.

      supportsRtl is false, and that is scope rather than oversight (DS-8, D-5). It used to be true,
      which was the worst of the three states available: a claim SwipeActionsRow does not honour.
      That row only opens leftwards and anchors its buttons at CenterEnd, so a mirrored layout would
      put the buttons on one side and the gesture pulling away from them. Making it
      direction-aware is a day of work for a reading direction this sideloaded build, with one
      left-to-right reader, will never meet — so the work is named here instead of done, and the day
      someone wants a second reading direction they know it is SwipeActionsRow's and not this file's.
      ReadingDirectionTest asserts the false, because true is what every template and every merge
      would quietly restore.
    -->
    <application
        android:name=".MegaPodcastPlayerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.MegaPodcastPlayer">

        <!--
          singleTop so a new-episode notification tapped while the app is running is delivered to
          the running instance through onNewIntent, rather than stacking a second copy of the app.

          The theme is the *starting* one: the system draws the splash from it before the process
          exists, and `installSplashScreen()` in MainActivity swaps it for Theme.MegaPodcastPlayer
          once there is a frame to show. Naming the post-splash theme here instead would leave the
          launch looking like a blank window for as long as Hilt and Room take to come up.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MegaPodcastPlayer.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Long-pressing the launcher icon: resume, queue, downloads, add a show.

              Attached to this activity because the platform reads the list from whichever activity
              carries the LAUNCHER filter, and every one of the four is a destination inside this
              single-activity app. What each intent's action means is decided in `LaunchShortcut`.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!--
              Share sheet: a podcast link shared out of a browser, a chat or Apple Podcasts.

              This is the ordinary way a show is discovered, and until now it took five steps —
              copy the link, leave the app you were in, open this one, tap add, paste. The text
              lands on the Search screen with the link already in the field, where the same
              classifier the paste path uses decides whether it is an Apple show, a YouTube
              playlist or a feed. Nothing is added without a tap; a shared link is untrusted input
              and gets the same one-tap confirmation a typed one does.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
              Tapping a podcast link, rather than sharing it.

              Deliberately narrow. `android:host` is named for every shape the link parser can
              actually resolve, so this app never appears in the chooser for a URL it would only
              fail on — a generic `http` filter would put it in front of every link on the device.
              RSS feeds live on hosts we cannot enumerate, so they arrive through the share sheet
              above instead; the `podcast://` and `feed://` schemes are the two conventional ones
              that name a feed unambiguously and cost nothing to accept.

              `autoVerify="false"` is stated rather than left out. These are other people's
              domains: no assetlinks.json of ours will ever be served from apple.com or youtube.com,
              so verification could only ever fail, and the app should be *offered* in the chooser
              rather than take the link over. Saying so explicitly is also what tells lint this is a
              deliberate share target and not a half-configured App Link.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="podcasts.apple.com" />
                <data android:host="itunes.apple.com" />
                <data android:host="music.apple.com" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:host="youtu.be" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="podcast" />
                <data android:scheme="feed" />
            </intent-filter>
        </activity>

        <!--
          The watch's end of the remote control. Play Services binds this — starting the app's
          process if necessary — whenever a message arrives on a /megapodcastplayer path from a device running
          an app with the same package name and signing certificate.
        -->
        <service
            android:name=".wearsync.WearCommandService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/megapodcastplayer" />
            </intent-filter>
        </service>

        <!--
          The home-screen widget. Glance draws it, this receiver is the name the platform knows it
          by, and res/xml/now_playing_widget_info.xml decides its sizes and says why it asks for no
          periodic update.

          Exported, as every app widget provider must be — the launcher is another process and has
          to be able to send it APPWIDGET_UPDATE. That is also why nothing in the widget or its
          action callbacks reads anything off the incoming intent: the two intent filters here are
          the platform's own, and everything the widget does is decided by what it drew.
        -->
        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <!--
          WorkManager's own foreground service, which DownloadExportWorker runs in while it copies a
          show's downloads to a folder. The platform refuses a foreground service whose type the
          manifest does not declare, and WorkManager's library manifest declares none, so the type
          is merged in here. dataSync is what copying files is, and its permission is declared above.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!--
          MegaPodcastPlayerApplication supplies WorkManager's Configuration so that @HiltWorker workers can be
          injected. On-demand initialisation and the default androidx.startup initializer are
          mutually exclusive, so the default one is removed here.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
