<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      New-episode notifications, posted by the periodic refresh (see sync/RefreshWorker).

      The two foreground services keep running without it — the platform never blocks a foreground
      service for want of this permission — but denying it hides their notifications, which for the
      player means no transport controls in the shade or on the lock screen. That is why it is asked
      for on first launch rather than behind the refresh setting; see ui/NotificationPermissionEffect.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Playback and download foreground services. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Resume interrupted downloads after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Playback reaches hosts we do not choose, some of which are still cleartext-only; see
      network_security_config.xml for why that is allowed and what limits it.

      Backup is on deliberately: a re-installed or replaced phone should come back with the user's
      subscriptions and listening positions. What travels and what does not is decided in
      data_extraction_rules.xml, which is the file to read before changing allowBackup.
    -->
    <application
        android:name=".BPodcatApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BPodcat">

        <!--
          singleTop so a new-episode notification tapped while the app is running is delivered to
          the running instance through onNewIntent, rather than stacking a second copy of the app.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BPodcat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The watch's end of the remote control. Play Services binds this — starting the app's
          process if necessary — whenever a message arrives on a /bpodcat path from a device running
          an app with the same package name and signing certificate.
        -->
        <service
            android:name=".wearsync.WearCommandService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bpodcat" />
            </intent-filter>
        </service>
        <!--
          BPodcatApplication supplies WorkManager's Configuration so that @HiltWorker workers can be
          injected. On-demand initialisation and the default androidx.startup initializer are
          mutually exclusive, so the default one is removed here.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
