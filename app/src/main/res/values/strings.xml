<?xml version="1.0" encoding="utf-8"?>
<!--
    Strings owned by the app shell: the launcher name and the navigation bar.

    Every screen's own copy lives in its feature module.
-->
<resources>

    <string name="app_name">MegaPodcastPlayer</string>

    <!-- Navigation bar / rail destinations. -->
    <string name="destination_listen">Listen</string>
    <string name="destination_library">Library</string>
    <string name="destination_queue">Queue</string>
    <string name="destination_moments">Moments</string>
    <string name="destination_downloads">Downloads</string>

    <!--
      The new-episode notification, posted by the periodic background refresh.

      The count is a plural and each line is a two-part string so a translator can reorder or
      re-punctuate the show and episode halves; concatenating them in code would take that away.
    -->
    <string name="new_episodes_channel_name">New episodes</string>
    <string name="new_episodes_channel_description">A quiet note when a show you follow publishes something new</string>

    <plurals name="new_episodes_title">
        <item quantity="one">%1$d new episode</item>
        <item quantity="other">%1$d new episodes</item>
    </plurals>

    <!-- One line of the notification: %1$s is the show, %2$s the episode. -->
    <string name="new_episodes_line">%1$s: %2$s</string>

    <!-- Last line when there were more episodes than the notification lists. -->
    <plurals name="new_episodes_more">
        <item quantity="one">and %1$d more</item>
        <item quantity="other">and %1$d more</item>
    </plurals>

    <!--
      The notification that keeps the phone working on a copy to the watch.

      It carries no progress and no tap target on purpose: the phone only knows what it has handed
      to the Bluetooth stack, and the watch already draws the honest bar. The text exists to answer
      the one question the card provokes — why is this taking so long.
    -->
    <string name="watch_transfer_channel_name">Copying to watch</string>
    <string name="watch_transfer_channel_description">Shown while an episode is being sent to your watch</string>
    <string name="watch_transfer_title">Copying to your watch</string>
    <string name="watch_transfer_text">Episodes cross over Bluetooth, which takes a few minutes.</string>

    <!--
      The end-of-episode bell, armed from the player by someone who is about to fall asleep.

      Deliberately plain: it is read half-awake, in the dark, and its whole job is to say which
      thing made the noise. The episode title is a separate string so the card still says something
      sensible when the player has no title to hand.
    -->
    <string name="bell_channel_name">End-of-episode bell</string>
    <string name="bell_channel_description">Rings when an episode you armed the bell for finishes</string>
    <string name="bell_title">Episode finished</string>
    <!-- %1$s is the episode title. -->
    <string name="bell_text">%1$s has ended. Playback is stopped.</string>
    <string name="bell_text_unknown_episode">Your episode has ended. Playback is stopped.</string>

    <!--
      The launcher's long-press shortcuts; see res/xml/shortcuts.xml.

      Short labels are one word wherever the destination has one, because a launcher truncates at
      around ten characters and a truncated label is worse than a shorter one. The long label is
      what a launcher with room shows, and what a home-screen shortcut pinned from this menu is
      named — so it is written as the thing it produces rather than as an instruction.
    -->
    <string name="shortcut_resume_short_label">Resume</string>
    <string name="shortcut_resume_long_label">Resume listening</string>
    <string name="shortcut_queue_short_label">Queue</string>
    <string name="shortcut_queue_long_label">Open the queue</string>
    <string name="shortcut_downloads_short_label">Downloads</string>
    <string name="shortcut_downloads_long_label">Downloaded episodes</string>
    <string name="shortcut_add_show_short_label">Add</string>
    <string name="shortcut_add_show_long_label">Add a show</string>

</resources>
