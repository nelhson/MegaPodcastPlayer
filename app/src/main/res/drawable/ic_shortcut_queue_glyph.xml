<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground layer of the *Queue* launcher shortcut: three list bars and a note.

    Same adaptive-icon geometry and colour as ic_shortcut_resume_glyph.xml. The third bar is short
    and the note sits in the gap it leaves, which is what distinguishes a queue from a plain list at
    the 36dp the launcher draws these at.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Two full-width bars and one short one, all 6 units tall with semicircular caps. -->
    <path
        android:fillColor="#FFB868"
        android:pathData="M31,34 H73 A3,3 0 0 1 73,40 H31 A3,3 0 0 1 31,34 Z" />
    <path
        android:fillColor="#FFB868"
        android:pathData="M31,48 H73 A3,3 0 0 1 73,54 H31 A3,3 0 0 1 31,48 Z" />
    <path
        android:fillColor="#FFB868"
        android:pathData="M31,62 H55 A3,3 0 0 1 55,68 H31 A3,3 0 0 1 31,62 Z" />

    <!-- The note: a stem down the right edge into a head that fills the short bar's gap. -->
    <path
        android:fillColor="#FFB868"
        android:pathData="M72,47 A3,3 0 0 1 78,47 V69 A3,3 0 0 1 72,69 Z" />
    <path
        android:fillColor="#FFB868"
        android:pathData="M60,70 a8,8 0 1 0 16,0 a8,8 0 1 0 -16,0 Z" />
</vector>
