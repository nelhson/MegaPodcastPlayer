<?xml version="1.0" encoding="utf-8"?>
<!--
  MegaPodcastPlayer launcher icon, background layer.

  A dark espresso wash, taken from the theme's `onPrimaryContainer`/`surface` browns so the icon
  reads as the same app as the UI. The layer fills the whole 108dp canvas because launchers may
  parallax or mask it to any shape — nothing here is load-bearing, so bleed is harmless.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item
                    android:color="#FF3E2410"
                    android:offset="0" />
                <item
                    android:color="#FF1A0E04"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
