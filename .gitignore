# Signing material. Never commit the release key or its passwords: a leaked key means
# rotating it and re-signing every installed APK.
keystore.properties
*.jks
*.keystore

# Per-developer Claude Code state. The project's shared skills in .claude/skills/ are committed;
# settings.local.json records one machine's permission grants and is not shared.
.claude/settings.local.json

# Cygwin/MSYS crash dumps, produced by the bash used for tooling on Windows.
*.stackdump

# Signed builds and their R8 mapping files, archived per commit by the distribute skill.
dist/
