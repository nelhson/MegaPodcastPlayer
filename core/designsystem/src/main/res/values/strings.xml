<?xml version="1.0" encoding="utf-8"?>
<!--
    Strings owned by shared components rather than by any one screen.

    Deliberately short: a design-system component that carries its own copy is a component that
    two screens cannot word differently. Only the labels that are part of the component's own
    contract live here — everything a screen says goes in that feature module's strings.xml.
-->
<resources>

    <!-- Brand name; never translated. -->
    <string name="designsystem_youtube" translatable="false">YouTube</string>

    <!-- TalkBack label for the badge marking a show that came from a YouTube playlist. -->
    <string name="designsystem_source_youtube_description">From YouTube</string>

    <!-- Announced while a screen has nothing to show yet. -->
    <string name="designsystem_loading">Loading</string>

    <!-- Transport control, announced instead of the glyph so it does not flip mid-animation. -->
    <string name="designsystem_play">Play</string>
    <string name="designsystem_pause">Pause</string>
    <string name="designsystem_buffering">Buffering</string>

    <!-- The scrubber. TalkBack reads the position from the progress range, not from this label. -->
    <string name="designsystem_seek">Playback position</string>

    <!-- Download control; one label per state of the same button. -->
    <string name="designsystem_download">Download</string>
    <string name="designsystem_download_queued">Download queued</string>
    <string name="designsystem_download_in_progress">Downloading, %1$d%%</string>
    <!-- COPY-2: the button deletes a file, and says so. -->
    <string name="designsystem_download_remove">Downloaded, delete from device</string>
    <string name="designsystem_download_retry">Download failed, retry</string>

    <!-- The mark on a row that is already stored. Not a control, so it names the fact, not an action. -->
    <string name="designsystem_downloaded">Downloaded</string>
    <!-- The second mark, beside it, when the episode's video is stored too. -->
    <string name="designsystem_video_downloaded">Video downloaded</string>

    <!--
        What the mark plus a number says out loud, where a show's line shows the glyph and the count
        instead of spelling it out. Never used for zero: nothing is drawn then.
    -->
    <plurals name="designsystem_downloaded_count">
        <item quantity="one">%1$d downloaded</item>
        <item quantity="other">%1$d downloaded</item>
    </plurals>

    <!-- The app bar's back arrow. Overridable, but this is the right answer nearly everywhere. -->
    <string name="designsystem_back">Back</string>
    <!-- The gear, on every top-level bar; see SettingsAction. -->
    <string name="designsystem_settings">Settings</string>

    <!-- Announced for the hairline that marks work the user did not ask for. -->
    <string name="designsystem_working">Working</string>

    <!-- A settings row reads as one control: its name, then what it does. -->
    <string name="designsystem_setting_description">%1$s. %2$s</string>

    <!-- A choice chip announces which setting it belongs to, not just its own caption. -->
    <string name="designsystem_choice_description">%1$s: %2$s</string>
    <string name="designsystem_chip_selected">Selected</string>
    <string name="designsystem_chip_not_selected">Not selected</string>

    <!--
        The video-download sheet, the one picker for keeping a video, from the show page and the
        video screen alike. Its words are its own because it is one component: the two copies it
        replaced said the same things two ways. "720p" in these is an already-formatted rendition
        (`formatVideoQuality`), never translated.

        The status line under the title says what the phone holds of the video now. A pick is not a
        download until Download is pressed, so the lines say "pick", not "tap".
    -->
    <!--
        The "Save to" picker beside a download button. A folder is a label on a download, not a
        place on the phone, so nothing here names a path. "Downloads" is the built-in folder every
        download is in until it is filed elsewhere; it shares its name with the Downloads tab.
    -->
    <string name="designsystem_folder_picker_label">Save to</string>
    <string name="designsystem_folder_downloads">Downloads</string>
    <!-- Spoken for the chip, whose label is only a folder's name. %1$s is the folder chosen. -->
    <string name="designsystem_folder_picker_description">Save to %1$s. Choose a folder</string>
    <string name="designsystem_folder_current">Current folder</string>
    <string name="designsystem_video_download_title">Download video</string>
    <string name="designsystem_video_download_description">Keeps the video on this phone to watch without a connection. The audio downloads with it.</string>
    <string name="designsystem_video_download_queued">Waiting to download %1$s.</string>
    <!-- Wi-Fi only is on by default, so this is the usual reason a video has not started. -->
    <string name="designsystem_video_download_queued_wifi">Waiting for Wi-Fi to download %1$s.</string>
    <!-- %1$s is a formatted rendition; %2$d is the percentage done. -->
    <string name="designsystem_video_download_progress">Downloading %1$s, %2$d%%.</string>
    <string name="designsystem_video_download_completed">%1$s is on this phone. Pick another quality to replace it.</string>
    <string name="designsystem_video_download_failed">Could not download %1$s. Pick a quality and try again.</string>
    <string name="designsystem_video_download_loading">Looking for qualities</string>
    <string name="designsystem_video_download_qualities_failed">Could not find out which qualities this video comes in. Check the connection and try again.</string>
    <string name="designsystem_video_download_empty">This video has no quality to download.</string>
    <string name="designsystem_video_download_confirm">Download</string>
    <!-- COPY-2: a finished video leaves the phone and is deleted; a transfer is called off. -->
    <string name="designsystem_video_download_delete">Delete downloaded video</string>
    <string name="designsystem_video_download_cancel">Cancel download</string>
    <!-- Asked before a finished video is deleted. %1$s is a formatted rendition, e.g. "720p". -->
    <string name="designsystem_video_download_delete_title">Delete the %1$s video?</string>
    <string name="designsystem_video_download_delete_text">The audio stays on this phone.</string>
    <string name="designsystem_video_download_delete_confirm">Delete</string>
    <string name="designsystem_video_download_delete_dismiss">Cancel</string>

    <!--
        The question before an episode's download is deleted, from the show page, Downloads and the
        player alike. It names the video when the video goes too, because deleting the audio takes
        the picture with it and a question that named only the sound undersold what was leaving.
        %1$s is the episode title, quoted (COPY-4); in the text, %1$s is a size, e.g. "412 MB".
    -->
    <string name="designsystem_delete_download_title">Delete \"%1$s\"?</string>
    <string name="designsystem_delete_download_title_with_video">Delete the audio and video of \"%1$s\"?</string>
    <string name="designsystem_delete_download_text_freeing">This frees %1$s. The episode stays in your library and can be downloaded again.</string>
    <string name="designsystem_delete_download_text">The episode stays in your library and can be downloaded again.</string>
    <string name="designsystem_delete_download_confirm">Delete</string>
    <string name="designsystem_delete_download_dismiss">Cancel</string>

    <!-- The download button's finished face when deleting would take the episode's video too. -->
    <string name="designsystem_download_remove_with_video">Audio and video downloaded, delete both from device</string>

    <!-- Announced as an episode row's state, in addition to its title. -->
    <string name="designsystem_state_played">Played</string>
    <string name="designsystem_state_unplayed">Not played</string>
    <string name="designsystem_state_in_progress">%1$d%% played</string>
    <string name="designsystem_state_now_playing">Now playing</string>

    <!--
        Badges on a finished episode, in Downloads and on a show's page, naming what of the episode
        is on the phone: its sound, its picture, or both. %1$s is the video's quality, already formatted, e.g. "720p".
    -->
    <string name="designsystem_badge_audio">Audio</string>
    <string name="designsystem_badge_video">Video · %1$s</string>
    <!--
        The same two, spoken. Drawn, a pill on an episode row says "on this phone" by where it is;
        read out, a bare "Audio" after an episode's title says nothing, so the spoken form says it.
    -->
    <string name="designsystem_badge_audio_spoken">Audio on this phone</string>
    <string name="designsystem_badge_video_spoken">Video on this phone, %1$s</string>
    <!-- The video badge is also the way to watch it; what a tap on it does, spoken. -->
    <string name="designsystem_badge_play_video">Play video</string>

</resources>
