<?xml version="1.0" encoding="utf-8"?>
<!--
    The name of the build type of the APK this library ended up in, for crash reports.

    Empty here on purpose. A library cannot know its application's build type — its own BuildConfig
    describes the library's variant, and `wrist` builds every library as `release` — so each
    application module overrides this string with its build type's name (`nameBuildTypesForCrashReports`
    in build-logic), and an application resource wins over a library's when the two are merged.
    `FirebaseCrashReporter` reads it, and falls back to the debuggable flag when it is still empty.
-->
<resources>
    <string name="crash_build_type" translatable="false" />
</resources>
