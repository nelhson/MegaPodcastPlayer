<?xml version="1.0" encoding="utf-8"?>
<!--
    Copy for the settings screen.

    Every chip row carries a `..._description` that repeats the setting name, because TalkBack
    reaches a chip out of context: "30 s" on its own says nothing about which interval it sets.
-->
<resources>

    <string name="settings_title">Settings</string>
    <string name="settings_back">Back</string>

    <string name="settings_section_appearance">Appearance</string>
    <string name="settings_section_notifications">Notifications</string>
    <string name="settings_section_playback">Playback</string>
    <string name="settings_section_downloads">Downloads</string>
    <string name="settings_section_storage">Storage</string>

    <!-- The three palettes, as the chip row lists them. "System" is the default. -->
    <string name="settings_theme">Theme</string>
    <string name="settings_theme_system">System</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>

    <!--
        Off by default, and that is the considered answer: the app has a palette of its own and
        wears it. This is here for people who would rather their phone matched itself.
    -->
    <string name="settings_dynamic_color_title">Use wallpaper colours</string>
    <string name="settings_dynamic_color_description">Take the palette from your wallpaper instead of the app\'s own</string>

    <!--
        Two descriptions for one switch: in a light theme it currently does nothing, and a switch
        that visibly changes nothing is worse than one that says why.
    -->
    <string name="settings_pure_black_title">Pure black in dark theme</string>
    <string name="settings_pure_black_description">True black backgrounds, which an OLED screen does not light at all</string>
    <string name="settings_pure_black_description_light">True black backgrounds; takes effect when the app is dark</string>

    <!--
        A link out rather than a set of switches: Android already owns every one of them, and per
        show — the part this app does own — lives on the show\'s own page.
    -->
    <string name="settings_notification_channels">Notification settings</string>
    <string name="settings_notification_channels_description">New episodes, downloads and the bell, in Android\'s own settings</string>

    <!-- SET-6: "default", because a show may override it; the row lists the ones that do. -->
    <string name="settings_playback_speed">Default speed</string>
    <string name="settings_skip_forward">Skip forward</string>
    <string name="settings_skip_back">Skip back</string>

    <string name="settings_auto_play_next_title">Play next automatically</string>
    <string name="settings_auto_play_next_description">Start the next queued episode when one finishes</string>

    <string name="settings_auto_download_title">Download new episodes</string>
    <string name="settings_auto_download_description">Save episodes for offline listening as they are published</string>

    <string name="settings_unmetered_title">Wi-Fi only</string>
    <string name="settings_unmetered_description">Wait for an unmetered network before downloading</string>

    <!--
        Bounds what "Download new episodes" fetches when a refresh finds several at once; it never
        deletes. It used to read "Episodes to keep per show", back when a refresh also swept a
        show's older downloads down to it.
    -->
    <string name="settings_keep_limit_title">New episodes to download per show</string>

    <string name="settings_delete_after_playing_title">Delete after playing</string>
    <string name="settings_delete_after_playing_description">Free up storage when an episode finishes</string>

    <string name="settings_downloaded_episodes">Downloaded episodes</string>
    <!-- COPY-2: these are files, and files are deleted. -->
    <string name="settings_remove_all">Delete all downloads</string>
    <!-- %1$s is the space that would be reclaimed, e.g. "512 MB". -->
    <string name="settings_remove_all_frees">Frees %1$s</string>
    <string name="settings_remove_all_nothing">Nothing is downloaded</string>
    <string name="settings_message_downloads_removed">Deleted all downloads, freeing %1$s</string>

    <!--
        The confirmation. There is no undo for deleted audio, so the question comes first and it
        counts what is at stake in both units: %1$d episodes and %2$s of space. The action names the
        verb rather than saying "OK", which is the rule every destructive dialog here follows.
    -->
    <string name="settings_remove_all_confirm_title">Delete every downloaded episode?</string>
    <plurals name="settings_remove_all_confirm_body">
        <item quantity="one">%1$d episode will be deleted from this device, freeing %2$s. You can download it again later.</item>
        <item quantity="other">%1$d episodes will be deleted from this device, freeing %2$s. You can download them again later.</item>
    </plurals>
    <string name="settings_remove_all_confirm_action">Delete</string>

    <!-- TalkBack label for a switch row: the setting name (%1$s) then its explanation (%2$s). -->
    <!-- TalkBack label for one chip: the setting name (%1$s) then the option (%2$s). -->

    <!-- Playback rate, e.g. "1.5x". %1$s is already formatted, so the "x" is the only copy. -->

    <!-- Skip intervals. Symbols rather than words: these sit inside a narrow chip. -->
    <string name="settings_skip_seconds">%1$d s</string>
    <string name="settings_skip_minutes">%1$d min</string>

    <!-- The "keep every episode" end of the keep-limit chips. -->
    <string name="settings_keep_limit_all">All</string>

    <string name="settings_storage_none">None</string>
    <plurals name="settings_episode_count">
        <item quantity="one">%1$d episode</item>
        <item quantity="other">%1$d episodes</item>
    </plurals>
    <!-- Joins the episode count (%1$s) with the size on disk (%2$s). -->
    <string name="settings_storage_summary">%1$s · %2$s</string>


    <!--
      Subscriptions: the one file this app writes and the one it reads, and the whole of what it
      carries is a list of links. A show is a feed URL — a podcast's RSS or a YouTube playlist's —
      and everything else the app knows about it is what fetching that URL produced. The export
      used to carry the produce too, in a second file of its own, and the two rows that offered
      them differed in a parenthesis. There is one pair now, and the format is named where it is
      acted on — the picker offers a ".opml" file — rather than in a label that would then say it
      twice.
    -->
    <string name="settings_section_subscriptions">Subscriptions</string>
    <string name="settings_subscriptions_export">Export subscriptions</string>
    <!--
      The export row's second line answers "what happens when the database is wiped", which is a
      real question here: it is recreated rather than migrated, so a build that changes the schema
      costs the user every show they have added. A date is the only useful answer, and "not
      exported yet" has to be visible before the release that acts on it rather than after.
    -->
    <string name="settings_subscriptions_never">Not exported yet</string>
    <string name="settings_subscriptions_last">Last exported: %1$s</string>
    <string name="settings_subscriptions_import">Import subscriptions</string>
    <string name="settings_subscriptions_import_description">Adds shows from a list exported here or by another app</string>
    <!-- Present tense with an ellipsis, per rule 7: this one is actually running. -->
    <string name="settings_subscriptions_importing">Adding shows…</string>
    <string name="settings_subscriptions_importing_progress">Adding %1$d of %2$d — %3$s</string>
    <string name="settings_subscriptions_import_failed">Import did not finish</string>
    <string name="settings_subscriptions_import_confirm_title">Add these shows?</string>
    <!--
      Says what an import will *not* do, because that is the half the user would otherwise be
      surprised by afterwards: a list of links restores links. A show already in the library is
      left alone, positions and all, which is worth stating in the same breath.
    -->
    <plurals name="settings_subscriptions_import_confirm_body">
        <item quantity="one">%1$d show will be added. A show you already have is left as it is — a list carries links, not positions or downloads.</item>
        <item quantity="other">%1$d shows will be added. A show you already have is left as it is — a list carries links, not positions or downloads.</item>
    </plurals>
    <!--
      Said rather than folded into the total: a file whose extra rows were folders is ordinary, one
      whose rows were mostly refused is worth looking at again, and a count of what arrived cannot
      tell the two apart.
    -->
    <plurals name="settings_subscriptions_import_skipped">
        <item quantity="one">%1$d entry was skipped: a folder, or a feed this app will not fetch.</item>
        <item quantity="other">%1$d entries were skipped: folders, or feeds this app will not fetch.</item>
    </plurals>
    <string name="settings_subscriptions_import_confirm_action">Add</string>
    <!-- Both dialogs on this screen dismiss with the same two words; rule 3 fixes "Cancel". -->
    <string name="settings_cancel">Cancel</string>
    <string name="settings_done">Done</string>
    <string name="settings_subscriptions_import_done_title">Import finished</string>
    <plurals name="settings_subscriptions_import_done_shows">
        <item quantity="one">%1$d show added.</item>
        <item quantity="other">%1$d shows added.</item>
    </plurals>
    <!--
      Named rather than counted: "2 shows could not be fetched" is not actionable, and the point of
      keeping the file is that the user can go and add the one that is missing.
    -->
    <string name="settings_subscriptions_import_done_failed">Could not fetch: %1$s</string>
    <string name="settings_subscriptions_exported">Subscriptions exported</string>
    <string name="settings_subscriptions_export_failed">Could not write the subscription list</string>
    <string name="settings_subscriptions_read_failed">Could not read that file</string>
    <string name="settings_subscriptions_not_recognised">That file is not an OPML subscription list</string>
    <string name="settings_subscriptions_empty">That subscription list has no shows in it</string>

    <!--
        SET-4. What an app should be able to say about itself: which build this is, whether its
        crash reporter is actually sending anything, and the licences of the fonts it ships.
    -->
    <string name="settings_section_about">About</string>
    <string name="settings_version">Version</string>
    <string name="settings_crash_reporting">Crash reporting</string>
    <!-- This build carries a Firebase configuration, so handled failures leave the device. -->
    <string name="settings_crash_reporting_on">On. Crashes and handled failures are sent to Firebase Crashlytics.</string>
    <!-- A build with no Firebase configuration, which is supported rather than broken. -->
    <string name="settings_crash_reporting_off">Off. This build has no crash reporting configured, so nothing leaves the device.</string>
    <string name="settings_font_licences">Font licences</string>
    <string name="settings_font_licences_description">Bricolage Grotesque and Inter, both under the SIL Open Font License 1.1</string>
    <string name="settings_close">Close</string>
    <!-- Displayed where the package manager reports no version at all. -->
    <string name="settings_version_unknown">—</string>

    <!--
        SET-6. The playback rate is a default, and a default is only a default if what departs from
        it is named. %1$s is the list of shows; each entry is settings_speed_override.
    -->
    <string name="settings_speed_overrides">Some shows play at their own speed: %1$s</string>
    <!-- One show and its rate: "Podlodka Podcast at 1.5x". -->
    <string name="settings_speed_override">%1$s at %2$s</string>
    <!-- Joins those entries, so a translator can re-punctuate the list. -->
    <string name="settings_list_separator">", "</string>
</resources>
