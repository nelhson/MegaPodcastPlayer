<?xml version="1.0" encoding="utf-8"?>
<!--
    Copy for the library screen.

    Counts are plurals rather than "%d episodes" so a translation into a language with more than
    two forms is possible without touching Kotlin. The two-part strings (`..._combined`) exist so a
    translator can reorder or re-punctuate the halves; concatenating in code would take that away.
-->
<resources>

    <string name="library_title">Library</string>

    <string name="library_add_podcast">Add a podcast</string>

    <!-- The empty state's action button; the add button itself uses library_add_podcast. -->
    <string name="library_add_search">Search Apple Podcasts</string>

    <!-- Top bar action; Settings is pushed from here rather than owning a navigation-bar slot. -->
    <string name="library_settings">Settings</string>

    <!--
        The reorder gesture, spoken. A drag is invisible to a screen reader, so without these the
        library would be readable and completely unarrangeable with TalkBack on.
    -->
    <string name="library_move_up">Move up</string>
    <string name="library_move_down">Move down</string>

    <!--
        The four orders the library can be in, as the sort menu lists them. "My order" rather than
        "Manual", because what it names is the arrangement the user dragged into place, and nobody
        thinks of their own shelf as manual.
    -->
    <string name="library_sort_manual">My order</string>
    <string name="library_sort_recent">Recently updated</string>
    <string name="library_sort_title">A–Z</string>
    <string name="library_sort_unplayed">Most unplayed</string>

    <!-- What the sort chip opens; it is labelled with the current order, not with a verb. -->
    <string name="library_sort_description">Sort shows</string>

    <!--
        The narrowing controls, shown only once the library is past a screenful. The field matches
        the author as well as the title, which the hint does not promise and does not need to.
    -->
    <string name="library_filter_hint">Find a show</string>
    <string name="library_filter_clear">Clear filter</string>
    <string name="library_filter_has_new">Has new episodes</string>

    <!-- Shown when the filter matches nothing, in place of the empty-library state. -->
    <string name="library_filtered_empty_title">No shows match</string>
    <string name="library_filtered_empty_description">Try part of the show\'s name or its author.</string>

    <!-- The grid/list toggle; each label says what tapping it will do. -->
    <string name="library_layout_show_grid">Show as grid</string>
    <string name="library_layout_show_list">Show as list</string>

    <!-- Announced for the hairline that marks the refresh run on entering the screen. -->
    <string name="library_refreshing">Checking for new episodes</string>

    <string name="library_loading">Loading your podcasts</string>

    <string name="library_empty_title">No podcasts yet</string>
    <string name="library_empty_description">Search Apple Podcasts, or paste an RSS or YouTube playlist link, to add your first show.</string>

    <!-- Episode count under a show. -->
    <plurals name="library_episode_count">
        <item quantity="one">%1$d episode</item>
        <item quantity="other">%1$d episodes</item>
    </plurals>

    <!-- The same count for a YouTube playlist, where the user calls them videos. -->
    <plurals name="library_video_count">
        <item quantity="one">%1$d video</item>
        <item quantity="other">%1$d videos</item>
    </plurals>

    <!--
        Never started, the same rule the show page's "Unplayed" chip applies. Kept apart from the
        new-episode count in library_message_new_episodes on purpose: "new" means arrived since you
        last looked, "unplayed" means never started, and the two numbers disagree constantly.
    -->
    <plurals name="library_unplayed_count">
        <item quantity="one">%1$d unplayed</item>
        <item quantity="other">%1$d unplayed</item>
    </plurals>

    <plurals name="library_downloaded_count">
        <item quantity="one">%1$d downloaded</item>
        <item quantity="other">%1$d downloaded</item>
    </plurals>

    <!--
        Joins two parts of the counts line (%1$s and %2$s). Applied more than once for a row that
        has all three of episodes, unplayed and downloaded to report.
    -->
    <string name="library_counts_combined">%1$s · %2$s</string>

    <!--
        The swipe action on a row. Kept short: it is drawn under an icon in a 76dp column, and the
        row a screen reader reads it from has already said which show it is talking about.
    -->
    <string name="library_action_remove">Remove</string>
    <string name="library_cancel">Cancel</string>

    <!--
        Removing a show cannot be undone — re-subscribing re-fetches the feed and loses every played
        flag, position and download — so it asks first. %1$s is the show title.
    -->
    <string name="library_remove_dialog_title">Remove %1$s?</string>
    <string name="library_remove_dialog_text">The show and everything stored for it are deleted. Adding it back later starts from scratch.</string>
    <plurals name="library_remove_dialog_at_stake">
        <item quantity="one">%1$d downloaded episode will be deleted.</item>
        <item quantity="other">%1$d downloaded episodes will be deleted.</item>
    </plurals>

    <!-- Snackbar after a show is removed; %1$s is the show title. -->
    <string name="library_message_removed">Removed %1$s</string>

    <plurals name="library_message_new_episodes">
        <item quantity="one">%1$d new episode</item>
        <item quantity="other">%1$d new episodes</item>
    </plurals>

    <plurals name="library_message_failed_feeds">
        <item quantity="one">%1$d feed failed</item>
        <item quantity="other">%1$d feeds failed</item>
    </plurals>

    <!-- Joins the new-episode count (%1$s) with the failed-feed count (%2$s). -->
    <string name="library_message_new_and_failed">%1$s · %2$s</string>

    <!-- Shown when a refresh found nothing new but some feeds failed; %1$s lists the show titles. -->
    <string name="library_message_refresh_failed">Couldn\'t refresh %1$s</string>

    <string name="library_message_no_new_episodes">No new episodes</string>

</resources>
