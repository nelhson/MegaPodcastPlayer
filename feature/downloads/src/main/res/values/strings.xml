<?xml version="1.0" encoding="utf-8"?>
<!--
    Copy for the downloads screen.

    The per-row metadata line ("24 Aug · 1 h 24 min · 90 MB · Played") is assembled from parts that
    come from `:core:common`'s formatters, which still format in English. Only the parts this
    screen owns are here; see Q-1 in docs/REFACTORING_PLAN.md.
-->
<resources>

    <string name="downloads_title">Downloads</string>

    <string name="downloads_loading">Loading your downloads</string>

    <string name="downloads_empty_title">Nothing downloaded</string>
    <string name="downloads_empty_description">Episodes you download appear here and play without a connection.</string>
    <string name="downloads_empty_action">Go to your library</string>

    <!--
        The chips over the list, drawn only once an episode has a video. Every row has sound, so
        "Audio" means sound only: read as "has sound" it would be the same as "All".
    -->
    <string name="downloads_filter_all">All</string>
    <string name="downloads_filter_audio">Audio</string>
    <string name="downloads_filter_video">Video</string>
    <!--
        COPY_RULES §8: a filter that matches nothing is not an empty collection, so it says so,
        says what would appear under it, and offers the way back rather than "Nothing downloaded".
    -->
    <string name="downloads_filtered_empty_title">No downloads match this filter</string>
    <string name="downloads_filtered_empty_audio">Episodes you download without their video appear here.</string>
    <string name="downloads_filtered_empty_video">Episodes you download with their video appear here.</string>
    <string name="downloads_filter_clear">Clear filter</string>

    <!--
        Folders. A folder is a label on a download, not a place on the phone: nothing here may
        claim a path or "phone storage". The built-in folder every download starts in is called
        Downloads, like the screen, and cannot be renamed or deleted. Folder names are names, and
        are not quoted (COPY_RULES §4, as a show's name is not).
    -->
    <string name="downloads_folder_all">All folders</string>
    <string name="downloads_folder_downloads">Downloads</string>
    <!-- Spoken for the folder chip, whose label is only a folder's name. -->
    <string name="downloads_folder_chip_description">Choose a folder</string>
    <!-- No ellipsis: it opens a dialog, and "…" is kept for something running (COPY_RULES §7). -->
    <string name="downloads_folder_new">New folder</string>
    <string name="downloads_folder_manage">Manage folders</string>
    <string name="downloads_folder_manage_title">Folders</string>
    <!-- Spoken for the tick beside the folder on screen, or the one a download is in. -->
    <string name="downloads_folder_current">Current folder</string>
    <plurals name="downloads_folder_count">
        <item quantity="one">%1$d download</item>
        <item quantity="other">%1$d downloads</item>
    </plurals>
    <!-- Joins a folder's count (%1$s) with the line saying it is the default (%2$s). -->
    <string name="downloads_folder_counts_combined">%1$s · %2$s</string>
    <string name="downloads_folder_is_default">New downloads go here</string>
    <!-- %1$s is a folder's name; the overflow button beside it. -->
    <string name="downloads_folder_more">More options for %1$s</string>
    <string name="downloads_folder_make_default">Make default</string>
    <string name="downloads_folder_rename">Rename</string>
    <string name="downloads_folder_delete">Delete folder</string>

    <!-- The name dialog, to make or rename a folder. -->
    <string name="downloads_folder_create_title">New folder</string>
    <string name="downloads_folder_rename_title">Rename folder</string>
    <string name="downloads_folder_name_label">Name</string>
    <string name="downloads_folder_create">Create</string>
    <string name="downloads_folder_cancel">Cancel</string>
    <string name="downloads_folder_name_blank">Type a name</string>
    <!-- %1$d is the longest name accepted. -->
    <plurals name="downloads_folder_name_too_long">
        <item quantity="one">Use %1$d character or fewer</item>
        <item quantity="other">Use %1$d characters or fewer</item>
    </plurals>
    <string name="downloads_folder_name_taken">There is already a folder with that name</string>

    <!--
        The delete question. Deleting the folder alone loses nothing, so the box that also deletes
        its downloads starts unticked, and the button repeats the verb with what it takes
        (COPY_RULES §3). %1$s is the folder's name.
    -->
    <string name="downloads_folder_delete_title">Delete folder %1$s?</string>
    <string name="downloads_folder_delete_empty">There is nothing in it.</string>
    <plurals name="downloads_folder_delete_moves">
        <item quantity="one">Its %1$d download moves to Downloads.</item>
        <item quantity="other">Its %1$d downloads move to Downloads.</item>
    </plurals>
    <plurals name="downloads_folder_delete_also">
        <item quantity="one">Also delete its %1$d download from this device</item>
        <item quantity="other">Also delete its %1$d downloads from this device</item>
    </plurals>
    <!-- %2$s is the space it gives back, e.g. "1.2 GB". -->
    <plurals name="downloads_folder_delete_also_freeing">
        <item quantity="one">Also delete its %1$d download, freeing %2$s</item>
        <item quantity="other">Also delete its %1$d downloads, freeing %2$s</item>
    </plurals>
    <string name="downloads_folder_delete_with_downloads">Delete folder and downloads</string>

    <!-- The move sheet. Its subtitle names the episode, quoted as an episode title is. -->
    <string name="downloads_move_title">Move to folder</string>
    <string name="downloads_move_subtitle">\"%1$s\"</string>
    <!-- The swipe that opens it: one word, drawn under an icon (COPY_RULES §2). -->
    <string name="downloads_action_move">Move</string>
    <!-- The snackbar after a move carries this, since a move is offered back rather than asked. -->
    <string name="downloads_action_undo">Undo</string>

    <!--
        A folder with nothing in it (COPY_RULES §8): says which, what would put something there,
        and offers the way to everything else. %1$s is the folder's name.
    -->
    <string name="downloads_folder_empty_title">Nothing in %1$s</string>
    <string name="downloads_folder_empty_description">Swipe a download and choose Move to put it here.</string>
    <string name="downloads_folder_show_all">Show all folders</string>

    <!--
        The headings the rows are grouped under, in the order they are drawn. Failures first: they
        are the only rows on this screen waiting on the user. Not shown when there is only one
        group, where a heading would name the only thing on screen.
    -->
    <string name="downloads_section_failed">Failed</string>
    <string name="downloads_section_downloading">Downloading</string>
    <string name="downloads_section_waiting">Waiting</string>
    <string name="downloads_section_ready">Ready</string>

    <!-- The tiers of a row's swipe; also spoken as its accessibility actions, so each names an action. -->
    <string name="downloads_action_queue">Add to queue</string>
    <!--
        COPY-2: a file leaves the device, so it is deleted; a transfer that has not finished has no
        file to delete and is called off instead. One gesture, two honest names.
    -->
    <string name="downloads_action_delete">Delete</string>
    <string name="downloads_action_cancel">Cancel download</string>
    <!--
        The same two when the episode's video is downloaded too: deleting the sound takes the
        picture with it, and a label that named only the sound undersold what was going.
    -->
    <string name="downloads_action_delete_with_video">Delete audio and video</string>
    <string name="downloads_action_cancel_with_video">Cancel audio and video</string>
    <!-- Only on a row that is actually waiting for Wi-Fi. Kept short: it is drawn under an icon. -->
    <string name="downloads_action_download_now">Download now</string>
    <!-- Only on a failed row. Tapping the row plays it; the swipe is what asks for it again. -->
    <string name="downloads_action_retry">Try again</string>

    <!-- A drag is invisible to a screen reader, so the reorder is published as these two actions. -->
    <string name="downloads_move_up">Move up</string>
    <string name="downloads_move_down">Move down</string>

    <!-- The storage card. %1$s is a size, e.g. "1.4 GB". -->
    <string name="downloads_storage_used">%1$s downloaded</string>
    <string name="downloads_storage_free">%1$s free</string>
    <!-- Read out instead of the bar, which is a picture of the two figures beside it. -->
    <string name="downloads_storage_bar_description">%1$s downloaded, %2$s free</string>

    <plurals name="downloads_episode_count">
        <item quantity="one">%1$d episode</item>
        <item quantity="other">%1$d episodes</item>
    </plurals>

    <!-- Joins the episode count (%1$s) with the size on disk (%2$s). -->
    <string name="downloads_storage_summary">%1$s · %2$s</string>

    <!--
        DL-3: what removes an episode from the device without being asked. Drawn as one line under
        the storage bar, on the screen the question "why did that disappear" is asked on. One rule
        only: the per-show limit bounds what a refresh downloads and never deletes anything.
    -->
    <string name="downloads_rules_delete_played">Deletes an episode when you finish it</string>
    <!-- The rule off: still stated, because "nothing" is an answer to the same question. -->
    <string name="downloads_rules_none">Nothing is deleted automatically</string>
    <!-- Spoken as what activating the line does; the chevron says it to everyone else. -->
    <string name="downloads_rules_action">Change in settings</string>

    <!-- Separates the parts of a row's metadata line. -->
    <string name="downloads_metadata_separator">" · "</string>

    <!-- Marks an episode that has been listened to all the way through. -->
    <string name="downloads_played">Played</string>

    <!--
        The state line under a row. A finished episode gets none: the screen is called Downloads,
        so saying "Downloaded" on every row adds nothing.
    -->
    <string name="downloads_state_downloading">Downloading %1$d%%</string>
    <string name="downloads_state_queued">Waiting to download</string>
    <!-- Wi-Fi only is on by default, so this is the usual reason a download has not started. -->
    <string name="downloads_state_queued_wifi">Waiting for Wi-Fi</string>
    <!-- Names the way out, because a tap plays the row rather than retrying it. -->
    <string name="downloads_state_failed">Download failed — swipe to try again</string>
    <!--
        The same states for the episode's video, after the sound's part of the line. The picture is
        often the larger, slower half, and a row whose sound was ready while its video waited or
        failed used to look finished. Nothing is said once the video is on the phone: the badge says
        it. The failure names the way out the sound's does, since the same swipe asks again.
    -->
    <string name="downloads_state_video_downloading">Video %1$d%%</string>
    <string name="downloads_state_video_queued">Video waiting to download</string>
    <string name="downloads_state_video_queued_wifi">Video waiting for Wi-Fi</string>
    <string name="downloads_state_video_failed">Video download failed</string>

    <!--
        Said after "Download now". Names the wider effect on purpose: Media3 enforces one network
        rule for the whole download manager, so anything else waiting starts too, and a message
        implying one episode was singled out would be a message that spends data without saying so.
        %1$s is the episode title.
    -->
    <string name="downloads_message_downloading_now">Downloading \"%1$s\" and anything else waiting, without Wi-Fi</string>

    <string name="downloads_message_removed">Deleted \"%1$s\" from this device</string>
    <!-- The queue is another tab, so the button needs a word here or nothing visibly happens. -->
    <string name="downloads_message_queued">Added \"%1$s\" to the queue</string>
    <!-- Nothing changed, and saying "added" about a queue that looks the same reads as a loss. -->
    <string name="downloads_message_already_queued">\"%1$s\" is already in the queue</string>
    <string name="downloads_message_already_playing">\"%1$s\" is already playing</string>
    <!-- A retry may sit waiting, so the confirmation says which of the two happened. -->
    <string name="downloads_message_retry_queued">Downloading \"%1$s\" again</string>
    <string name="downloads_message_retry_queued_wifi">\"%1$s\" will download on Wi-Fi</string>
    <string name="downloads_message_unavailable">That episode is no longer in your library</string>

    <!-- The top bar action that saves the finished downloads as a Markdown list, one link each. -->
    <string name="downloads_export_list">Export download list</string>
    <string name="downloads_message_list_exported">Download list exported</string>
    <string name="downloads_message_list_export_failed">Could not write that file</string>
    <string name="downloads_message_nothing_to_export">Nothing has finished downloading yet</string>
    <!-- %1$s is the episode title, %2$s the folder it went to. -->
    <string name="downloads_message_moved">Moved \"%1$s\" to %2$s</string>
    <string name="downloads_message_folder_deleted">Deleted folder %1$s</string>
    <!-- %1$s is the folder's name, %2$d how many downloads went with it. -->
    <plurals name="downloads_message_folder_deleted_with_downloads">
        <item quantity="one">Deleted folder %1$s and its %2$d download</item>
        <item quantity="other">Deleted folder %1$s and its %2$d downloads</item>
    </plurals>
</resources>
