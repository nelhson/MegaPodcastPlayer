<?xml version="1.0" encoding="utf-8"?>
<!--
    Copy for the downloads screen.

    The per-row metadata line ("24 Aug · 1 h 24 min · 90 MB · Played") is assembled from parts that
    come from `:core:common`'s formatters, which still format in English. Only the parts this
    screen owns are here; see Q-1 in docs/REFACTORING_PLAN.md.
-->
<resources>

    <string name="downloads_title">Downloads</string>

    <string name="downloads_loading">Loading your downloads</string>

    <string name="downloads_empty_title">Nothing downloaded</string>
    <string name="downloads_empty_description">Episodes you download appear here and play without a connection.</string>
    <string name="downloads_empty_action">Go to your library</string>

    <!-- The two tiers of a row's swipe; also spoken as its accessibility actions, so both name an action. -->
    <string name="downloads_action_queue">Add to queue</string>
    <string name="downloads_action_remove">Remove</string>

    <!-- A drag is invisible to a screen reader, so the reorder is published as these two actions. -->
    <string name="downloads_move_up">Move up</string>
    <string name="downloads_move_down">Move down</string>

    <!-- Confirmation before deleting audio, which no second gesture undoes. %1$s is the episode. -->
    <string name="downloads_remove_dialog_title">Remove \"%1$s\"?</string>
    <!-- %1$s is the freed size, e.g. "148 MB". -->
    <string name="downloads_remove_dialog_text">This frees %1$s. The episode stays in your library and can be downloaded again.</string>
    <string name="downloads_remove_confirm">Remove</string>
    <string name="downloads_cancel">Cancel</string>

    <!-- The storage card. %1$s is a size, e.g. "1.4 GB". -->
    <string name="downloads_storage_used">%1$s downloaded</string>
    <string name="downloads_storage_free">%1$s free</string>
    <!-- Read out instead of the bar, which is a picture of the two figures beside it. -->
    <string name="downloads_storage_bar_description">%1$s downloaded, %2$s free</string>

    <plurals name="downloads_episode_count">
        <item quantity="one">%1$d episode</item>
        <item quantity="other">%1$d episodes</item>
    </plurals>

    <!-- Joins the episode count (%1$s) with the size on disk (%2$s). -->
    <string name="downloads_storage_summary">%1$s · %2$s</string>

    <!-- Separates the parts of a row's metadata line. -->
    <string name="downloads_metadata_separator">" · "</string>

    <!-- Marks an episode that has been listened to all the way through. -->
    <string name="downloads_played">Played</string>

    <!--
        The state line under a row. A finished episode gets none: the screen is called Downloads,
        so saying "Downloaded" on every row adds nothing.
    -->
    <string name="downloads_state_downloading">Downloading %1$d%%</string>
    <string name="downloads_state_queued">Waiting to download</string>
    <!-- Wi-Fi only is on by default, so this is the usual reason a download has not started. -->
    <string name="downloads_state_queued_wifi">Waiting for Wi-Fi</string>
    <!-- Names the action, because tapping the row is what retries it. -->
    <string name="downloads_state_failed">Download failed — tap to try again</string>

    <string name="downloads_message_removed">Removed \"%1$s\" from this device</string>
    <!-- The queue is another tab, so the button needs a word here or nothing visibly happens. -->
    <string name="downloads_message_queued">Added \"%1$s\" to the queue</string>
    <!-- A retry may sit waiting, so the confirmation says which of the two happened. -->
    <string name="downloads_message_retry_queued">Downloading \"%1$s\" again</string>
    <string name="downloads_message_retry_queued_wifi">\"%1$s\" will download on Wi-Fi</string>
    <string name="downloads_message_unavailable">That episode is no longer in your library</string>

</resources>
