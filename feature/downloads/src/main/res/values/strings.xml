<?xml version="1.0" encoding="utf-8"?>
<!--
    Copy for the downloads screen.

    The per-row metadata line ("24 Aug · 1 h 24 min · 90 MB · Played") is assembled from parts that
    come from `:core:common`'s formatters, which still format in English. Only the parts this
    screen owns are here; see Q-1 in docs/REFACTORING_PLAN.md.
-->
<resources>

    <string name="downloads_title">Downloads</string>

    <string name="downloads_loading">Loading your downloads</string>

    <string name="downloads_empty_title">Nothing downloaded</string>
    <string name="downloads_empty_description">Episodes you download appear here and play without a connection.</string>
    <string name="downloads_empty_action">Go to your library</string>

    <!--
        The headings the rows are grouped under, in the order they are drawn. Failures first: they
        are the only rows on this screen waiting on the user. Not shown when there is only one
        group, where a heading would name the only thing on screen.
    -->
    <string name="downloads_section_failed">Failed</string>
    <string name="downloads_section_downloading">Downloading</string>
    <string name="downloads_section_waiting">Waiting</string>
    <string name="downloads_section_ready">Ready</string>

    <!-- The tiers of a row's swipe; also spoken as its accessibility actions, so each names an action. -->
    <string name="downloads_action_queue">Add to queue</string>
    <!--
        COPY-2: a file leaves the device, so it is deleted; a transfer that has not finished has no
        file to delete and is called off instead. One gesture, two honest names.
    -->
    <string name="downloads_action_delete">Delete</string>
    <string name="downloads_action_cancel">Cancel download</string>
    <!-- Only on a row that is actually waiting for Wi-Fi. Kept short: it is drawn under an icon. -->
    <string name="downloads_action_download_now">Download now</string>
    <!-- Only on a failed row. Tapping the row plays it; the swipe is what asks for it again. -->
    <string name="downloads_action_retry">Try again</string>

    <!-- A drag is invisible to a screen reader, so the reorder is published as these two actions. -->
    <string name="downloads_move_up">Move up</string>
    <string name="downloads_move_down">Move down</string>

    <!-- Confirmation before deleting audio, which no second gesture undoes. %1$s is the episode. -->
    <string name="downloads_remove_dialog_title">Delete \"%1$s\"?</string>
    <!-- %1$s is the freed size, e.g. "148 MB". -->
    <string name="downloads_remove_dialog_text">This frees %1$s. The episode stays in your library and can be downloaded again.</string>
    <string name="downloads_remove_confirm">Delete</string>
    <string name="downloads_cancel">Cancel</string>

    <!-- The storage card. %1$s is a size, e.g. "1.4 GB". -->
    <string name="downloads_storage_used">%1$s downloaded</string>
    <string name="downloads_storage_free">%1$s free</string>
    <!-- Read out instead of the bar, which is a picture of the two figures beside it. -->
    <string name="downloads_storage_bar_description">%1$s downloaded, %2$s free</string>

    <plurals name="downloads_episode_count">
        <item quantity="one">%1$d episode</item>
        <item quantity="other">%1$d episodes</item>
    </plurals>

    <!-- Joins the episode count (%1$s) with the size on disk (%2$s). -->
    <string name="downloads_storage_summary">%1$s · %2$s</string>

    <!--
        DL-3: what removes an episode from the device without being asked. Drawn as one line under
        the storage bar, on the screen the question "why did that disappear" is asked on. One rule
        only: the per-show limit bounds what a refresh downloads and never deletes anything.
    -->
    <string name="downloads_rules_delete_played">Deletes an episode when you finish it</string>
    <!-- The rule off: still stated, because "nothing" is an answer to the same question. -->
    <string name="downloads_rules_none">Nothing is deleted automatically</string>
    <!-- Spoken as what activating the line does; the chevron says it to everyone else. -->
    <string name="downloads_rules_action">Change in settings</string>

    <!-- Separates the parts of a row's metadata line. -->
    <string name="downloads_metadata_separator">" · "</string>

    <!-- Marks an episode that has been listened to all the way through. -->
    <string name="downloads_played">Played</string>

    <!--
        The state line under a row. A finished episode gets none: the screen is called Downloads,
        so saying "Downloaded" on every row adds nothing.
    -->
    <string name="downloads_state_downloading">Downloading %1$d%%</string>
    <string name="downloads_state_queued">Waiting to download</string>
    <!-- Wi-Fi only is on by default, so this is the usual reason a download has not started. -->
    <string name="downloads_state_queued_wifi">Waiting for Wi-Fi</string>
    <!-- Names the way out, because a tap plays the row rather than retrying it. -->
    <string name="downloads_state_failed">Download failed — swipe to try again</string>

    <!--
        Said after "Download now". Names the wider effect on purpose: Media3 enforces one network
        rule for the whole download manager, so anything else waiting starts too, and a message
        implying one episode was singled out would be a message that spends data without saying so.
        %1$s is the episode title.
    -->
    <string name="downloads_message_downloading_now">Downloading \"%1$s\" and anything else waiting, without Wi-Fi</string>

    <string name="downloads_message_removed">Deleted \"%1$s\" from this device</string>
    <!-- The queue is another tab, so the button needs a word here or nothing visibly happens. -->
    <string name="downloads_message_queued">Added \"%1$s\" to the queue</string>
    <!-- Nothing changed, and saying "added" about a queue that looks the same reads as a loss. -->
    <string name="downloads_message_already_queued">\"%1$s\" is already in the queue</string>
    <string name="downloads_message_already_playing">\"%1$s\" is already playing</string>
    <!-- A retry may sit waiting, so the confirmation says which of the two happened. -->
    <string name="downloads_message_retry_queued">Downloading \"%1$s\" again</string>
    <string name="downloads_message_retry_queued_wifi">\"%1$s\" will download on Wi-Fi</string>
    <string name="downloads_message_unavailable">That episode is no longer in your library</string>

    <!-- The top bar action that saves the finished downloads as a Markdown list, one link each. -->
    <string name="downloads_export_list">Export download list</string>
    <string name="downloads_message_list_exported">Download list exported</string>
    <string name="downloads_message_list_export_failed">Could not write that file</string>
    <string name="downloads_message_nothing_to_export">Nothing has finished downloading yet</string>

</resources>
