<?xml version="1.0" encoding="utf-8"?>
<!--
    Copy for the mini player and the full now-playing screen.

    The playback position labels (`4:12`, `1:04:12`) stay in Kotlin: they are numeric formats, not
    copy, and they are shared with the watch.

    "Play" and "Pause" are not here either: both players now draw the design system's own
    PlayPauseButton, which carries its labels with it. Two copies of the same word would have been
    two things to translate and one to forget.
-->
<resources>

    <!--
        Opening is a tap on the bar, and there is no matching label for closing: the expanded sheet
        is closed by dragging its grabber down or by the back gesture, not by a button.
    -->
    <string name="player_expand">Open the player</string>

    <!--
        Dismissing the bar. The gesture is a pull downwards on the collapsed player; this is its
        spoken twin, offered as a custom action so a screen reader can do the same thing, and the
        label of the close button in the expanded player's top-left corner. It says what happens
        rather than "close", because playback stops as well as the bar disappearing.
    -->
    <string name="player_dismiss">Stop playing and hide the player</string>
    <!-- Snackbar after the gesture. The queue it emptied is offered back. -->
    <string name="player_dismissed">Playback stopped</string>
    <string name="player_dismiss_undo">Undo</string>

    <string name="player_idle_title">Nothing playing</string>
    <string name="player_idle_description">Pick an episode from one of your shows and it will appear here.</string>

    <!--
        The queue screen. Its title names the whole list, so nothing heads the rows: a section
        header under a large app bar that already says "Queue" only repeated it. It is a top-level
        tab, so there is no back arrow and no label for one. What is playing is not repeated here
        either — the player says that, on every screen.
    -->
    <string name="queue_title">Queue</string>
    <!-- Under the title; %1$s is an already-formatted duration, e.g. "3 h 12 min". -->
    <string name="queue_remaining">%1$s left</string>
    <!--
        The one row above the list. The screen lists only what is *next*, which used to leave it
        saying nothing at all about the episode the queue is a queue behind.
    -->
    <string name="queue_now_playing">Now playing</string>
    <!-- Empties the whole queue, the episode playing included, and stops playback. -->
    <string name="queue_clear">Clear queue</string>
    <string name="queue_empty_title">Nothing queued</string>
    <string name="queue_empty_description">Add episodes to the queue and they will line up here, ready to play one after another.</string>

    <!--
        Reordering is a drag and the two edits are a swipe, and a screen reader can do neither, so
        all of them are offered again as spoken actions on the row.
    -->
    <string name="queue_move_up">Move up</string>
    <string name="queue_move_down">Move down</string>

    <!--
        The swipe action. This is a spoken label as much as a written one, so it is kept to one
        word: the row a screen reader reads it from has already said which episode it is talking
        about.
    -->
    <string name="queue_action_remove">Remove</string>

    <!--
        Snackbar after a swipe; %1$s is the episode title. It is offered back. Quoted, because an
        episode title is a sentence and a bare one runs into the words around it — the rule the
        other two screens already followed and this one did not (COPY-2, docs/COPY_RULES.md).
    -->
    <string name="queue_message_removed">Removed \"%1$s\"</string>
    <!-- Snackbar after Clear queue; %1$d is how many episodes left it. Offered back. -->
    <plurals name="queue_message_cleared">
        <item quantity="one">Removed %1$d episode from the queue</item>
        <item quantity="other">Removed %1$d episodes from the queue</item>
    </plurals>
    <string name="queue_undo">Undo</string>

    <string name="player_scrubber">Playback position</string>
    <!--
        Spoken label for the tap that cycles the right-hand timecode. A screen reader cannot see
        that the label changed, so the action has to say what it does rather than what it shows.
    -->
    <string name="player_time_label_cycle">Show time left, total length, or when it ends</string>
    <!-- Shown in place of a duration the player has not read yet; a wrong number would read as fact. -->
    <string name="player_unknown_duration">—</string>

    <string name="player_previous">Restart or go to the previous episode</string>
    <string name="player_next">Next episode</string>

    <!--
        The same two buttons on an episode that has chapters, where they move between chapters
        instead. Only the spoken label changes: the chapter title under the episode's own says
        which the buttons mean to everyone who can see it.
    -->
    <string name="player_previous_chapter">Restart or go to the previous chapter</string>
    <string name="player_next_chapter">Next chapter</string>

    <!-- TalkBack labels for the skip buttons; the glyph carries the number visually. -->
    <plurals name="player_skip_forward">
        <item quantity="one">Skip ahead %1$d second</item>
        <item quantity="other">Skip ahead %1$d seconds</item>
    </plurals>
    <plurals name="player_skip_back">
        <item quantity="one">Skip back %1$d second</item>
        <item quantity="other">Skip back %1$d seconds</item>
    </plurals>

    <!--
        The link from the player into the queue; %1$d is how many episodes follow this one.

        The empty form matters more than the others: the link used to disappear with the queue,
        which meant the player never mentioned that a queue existed to the one person who most
        needed telling — the one who has not put anything in it.
    -->
    <string name="player_queue_empty_summary">Up next · nothing queued</string>
    <plurals name="player_queue_summary">
        <item quantity="one">Up next · %1$d episode</item>
        <item quantity="other">Up next · %1$d episodes</item>
    </plurals>

    <!--
        Playback failures, worded as what happened and what to do about it.

        The player used to show the exception's own message, which is written for whoever reads the
        bug report — "Source error", "Response code: 404" — and says neither. Three of these four
        have something the user can act on; the fourth keeps the player's own words, because when
        the app does not know what happened the least useful thing it can do is pretend it does.
        %1$s is that text.
    -->
    <string name="player_error_no_connection">Could not reach the episode. Check your connection, or play a downloaded episode.</string>
    <string name="player_error_episode_gone">That episode is no longer where the feed says it is. Refreshing the show may fix it.</string>
    <string name="player_error_unsupported_format">This phone cannot play that audio format.</string>
    <string name="player_error_youtube">Could not get the audio for this video. Try again in a moment.</string>
    <string name="player_error">Playback problem: %1$s</string>

    <!--
      The sleep timer, opened from the player by someone about to fall asleep.

      It absorbed the end-of-episode bell, which is now one of its options rather than a second
      control beside it: two "stop later" buttons on a transport row was one too many. The button's
      content descriptions are chosen by what the timer is doing, and a counted-down one says how
      long is left — a control that differs only by colour tells a TalkBack user nothing. The
      end-of-chapter one says "a chapter" rather than which: the button is told what the timer is
      doing, not what the chapters are called, and the sheet it opens names the one chosen.
    -->
    <string name="player_sleep_arm">Sleep timer</string>
    <!-- %1$s is an already-formatted remaining time, e.g. "18 min". -->
    <string name="player_sleep_armed">Sleep timer, %1$s left; tap to change it</string>
    <string name="player_sleep_armed_end_of_episode">Sleep timer set to the end of this episode; tap to change it</string>
    <string name="player_sleep_armed_end_of_chapter">Sleep timer set to the end of a chapter; tap to change it</string>
    <!--
      The same two with the time the button now shows under them, %1$s as above. The ones without
      it stay for an episode whose length is not known yet, where there is no time to give.
    -->
    <string name="player_sleep_armed_end_of_episode_in">Sleep timer set to the end of this episode, %1$s left; tap to change it</string>
    <string name="player_sleep_armed_end_of_chapter_in">Sleep timer set to the end of a chapter, %1$s left; tap to change it</string>

    <string name="sleep_title">Sleep timer</string>
    <string name="sleep_description">Playback fades out and pauses. Shake the phone to add fifteen minutes.</string>
    <!--
      The lengths of time are a menu under one chip, fifteen minutes to four hours, captioned by the
      shared duration formatter ("1 h 30 min"). They were four chips in a row, and the fourth did
      not fit. The chip says what it offers until a countdown is running and how long is left once
      one is; its description supplies the verb either label lacks.
    -->
    <string name="sleep_after">Stop after a set time</string>
    <!-- %1$s is an already-formatted remaining time, e.g. "18 min". -->
    <string name="sleep_after_running">%1$s left</string>
    <string name="sleep_after_menu">Choose how long to keep playing</string>
    <string name="sleep_end_of_episode">End of episode</string>
    <!--
      "End of chapter" alone means the chapter playing, which is the common case and stays one tap.
      The chip beside it names the chapter that tap would stop after, and opens the ones still to
      come. A chapter is captioned by its number as well as its title (%1$d, then %2$s) because
      titles repeat — every "Ad break" is a different place to stop — and some are blank.
    -->
    <string name="sleep_end_of_chapter">End of chapter</string>
    <string name="sleep_chapter_option">%1$d. %2$s</string>
    <string name="sleep_chapter_menu">Choose the chapter to stop after</string>
    <string name="sleep_cancel">Turn the timer off</string>
    <string name="sleep_shake_hint">Still awake? Shake the phone to add fifteen minutes.</string>

    <!--
      The speed picker, opened from the player.

      It replaced a cycle button, whose only label was the rate itself; a control that opens a sheet
      has to say so, which is why the button's description now ends the same way the sleep timer's
      does. The slider is named and its value spoken separately, because "1.5x" alone tells a
      TalkBack user a number and not what it is a number of.
    -->
    <!-- %1$s is an already-formatted rate, e.g. "1.5x". -->
    <string name="player_speed">Playback speed, %1$s; tap to change it</string>
    <!-- Same, when the rate is one the show asked for rather than the app-wide one. -->
    <string name="player_speed_for_show">Playback speed, %1$s, set for this show; tap to change it</string>

    <string name="speed_title">Playback speed</string>
    <string name="speed_description">Applies to everything you play, until you change it.</string>
    <string name="speed_slider">Playback speed</string>
    <string name="speed_slower">Slower</string>
    <string name="speed_faster">Faster</string>
    <!--
        Spoken for the 1x chip, which is marked as the default by a tint and a glyph a screen
        reader cannot see. It restates the rate because a content description replaces the label
        it sits on rather than adding to it: without "%1$s" here, the one chip whose rate is not
        spoken would be the one in the middle of the scale.
    -->
    <string name="speed_default">%1$s, normal speed</string>

    <!--
      Moments: the timestamped bookmarks saved from the player.

      The mark button is announced with the running count when there is one, because the number
      beside it is the only visible evidence that pressing it did anything.

      "Save moment", the same two words the watch's own button uses. The two surfaces used to say
      "Save this moment" and "Moment" for the identical action, which is how one gesture comes to
      look like two features.
    -->
    <string name="player_moment_mark">Save moment</string>
    <plurals name="player_moment_mark_with_count">
        <item quantity="one">Save moment; %1$d saved in this episode</item>
        <item quantity="other">Save moment; %1$d saved in this episode</item>
    </plurals>
    <!--
        The list the count opens onto. The player showed a number of moments and no way to read
        them: they could only be seen on the Moments tab, which is a long way to go to hear a
        sentence again. %1$d is how many this episode has.
    -->
    <string name="player_moments_open">Show the moments in this episode</string>
    <plurals name="player_moments_sheet_title">
        <item quantity="one">%1$d moment</item>
        <item quantity="other">%1$d moments</item>
    </plurals>
    <string name="player_moments_sheet_description">Tap one to jump there.</string>
    <!-- A moment saved without typing anything, which is the common case. -->
    <string name="player_moment_no_note">No note</string>

    <!--
      The video screen: a YouTube episode's picture, shown on a screen of its own.

      The way in is one button on the expanded player, drawn only for an episode that has a picture
      to show. It says "the video" rather than "video" because the episode *is* a video already
      playing — the button does not start anything, it shows what is there.
    -->
    <string name="player_watch">Watch the video</string>
    <!--
      What a tap on the collapsed bar does while the episode is being watched: the bar is then the
      video put away, and the tap brings the picture back rather than opening the audio player.
    -->
    <string name="player_show_video">Show the video</string>
    <!--
      The two ways out of the video screen. Minimising keeps the episode playing behind the
      collapsed bar, and a tap on the bar comes back; the label says what happens to the video
      rather than "close", because nothing is closed. Switching to audio changes which player the
      episode is in: it is the mirror of "Watch the video" on the audio player.
    -->
    <string name="video_collapse">Minimise the video</string>
    <string name="video_listen">Switch to audio</string>
    <!--
      Spoken labels for the tap that shows and hides everything but the picture, which a screen
      reader cannot see happening.
    -->
    <string name="video_show_controls">Show the controls</string>
    <string name="video_hide_controls">Hide the controls</string>

    <!--
      The quality picker. The button's label is the height alone — "720p" is how every video
      service names a rendition and needs no word beside it — and its description supplies what the
      label lacks, in the shape the speed button's does.
    -->
    <string name="video_quality_title">Video quality</string>
    <string name="video_quality_description">Applies to every video you watch, until you change it. A video that has nothing this sharp plays at the best it has.</string>
    <!-- %1$d is the rendition's height in pixels. -->
    <string name="video_quality_label">%1$dp</string>
    <!-- %1$s is an already-formatted rendition, e.g. "720p". -->
    <string name="video_quality_button">Video quality, %1$s; tap to change it</string>
    <!--
      The two things the picker can say instead of a list. The first is a fact about the video and
      stays; the second is the extractor failing and asks for another go, as the playback errors do.
    -->
    <string name="video_quality_none">This video has no picture the app can play.</string>
    <string name="video_quality_unavailable">Could not find out which qualities this video comes in. Try again in a moment.</string>
    <!--
      Snackbar when the service would not show the picture. It says what did *not* change — the
      sound — because a black screen with a message could otherwise read as playback having stopped.
    -->
    <string name="video_refused">Could not show the video. It keeps playing as audio.</string>

    <!--
      Downloading the video, beside the quality button. The picker lists the same qualities the
      video can be watched at, because a download is only worth having at a height the player can
      show. The description says the audio comes along: the picture plays merged with the episode's
      audio, so an offline video is both, and a user watching their storage should know why.
    -->
    <string name="video_download_title">Download video</string>
    <string name="video_download_description">Keeps the video on this phone to watch without a connection. The audio downloads with it.</string>
    <!-- The sheet's subtitle once a download exists. %1$s is a formatted rendition, e.g. "720p". -->
    <string name="video_download_queued">Waiting to download %1$s. Tap another quality to download that instead.</string>
    <!-- %1$s is a formatted rendition; %2$d is the percentage done. -->
    <string name="video_download_progress">Downloading %1$s, %2$d%%. Tap another quality to download that instead.</string>
    <string name="video_download_completed">%1$s is on this phone. Tap another quality to replace it.</string>
    <string name="video_download_failed">Could not download %1$s. Tap a quality to try again.</string>
    <!--
      COPY-2: a finished video leaves the device, so it is deleted; a transfer has no file yet and
      is called off instead.
    -->
    <string name="video_download_delete">Delete downloaded video</string>
    <string name="video_download_cancel">Cancel download</string>
    <!-- Asked before a finished video is deleted. %1$s is a formatted rendition, e.g. "720p". -->
    <string name="video_download_delete_title">Delete the %1$s video?</string>
    <string name="video_download_delete_text">The audio stays on this phone.</string>
    <string name="video_download_delete_confirm">Delete</string>
    <string name="video_download_delete_cancel">Cancel</string>
    <!--
      Spoken names of the download button, which is an icon. Each says what the button shows and
      what a tap does, the shape the quality button's description has.
    -->
    <string name="video_download_button">Download the video</string>
    <!-- %1$d is the percentage done. -->
    <string name="video_download_button_progress">Downloading the video, %1$d%%; tap to change it</string>
    <!-- %1$s is a formatted rendition, e.g. "720p". -->
    <string name="video_download_button_done">Video downloaded at %1$s; tap to change it</string>
    <!-- Snackbars after the sheet closes. %1$s is a formatted rendition, e.g. "720p". -->
    <string name="video_download_message_queued">Downloading the video at %1$s</string>
    <string name="video_download_message_deleted">Deleted the downloaded video</string>
    <string name="video_download_message_cancelled">Cancelled the video download</string>
    <string name="video_download_message_failed">Could not download this video</string>

    <!-- %1$s is the timecode that was marked, e.g. "12:23". -->
    <string name="player_moment_saved">Moment saved at %1$s</string>
    <string name="player_moment_add_note">Note</string>
    <string name="player_moment_note_title">Note on this moment</string>
    <string name="player_moment_note_hint">What was said?</string>
    <string name="player_moment_note_save">Save</string>
    <string name="player_moment_note_cancel">Cancel</string>

</resources>
