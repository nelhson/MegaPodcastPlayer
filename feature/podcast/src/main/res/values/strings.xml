<?xml version="1.0" encoding="utf-8"?>
<!--
    Copy for the podcast detail screen.

    Every per-episode button names the episode it acts on: TalkBack reaches these out of the list's
    reading order, without the title beside them.

    The date and duration parts of a row's metadata line come from `:core:common`'s formatters,
    which still format in English; see Q-1 in docs/REFACTORING_PLAN.md.
-->
<resources>

    <string name="podcast_back">Back to the library</string>
    <!--
        COPY-2: a show leaves the *library*, so it is removed; the audio it takes with it is
        deleted. Named rather than bare, because this entry sits in a menu of five unlike actions.
    -->
    <string name="podcast_remove">Remove show</string>
    <string name="podcast_more_actions">More actions</string>
    <!--
        The show header's one button, which reads as whatever there is to do next.

        "Newest" rather than "latest": *latest* reads as "the most recent one I played" as readily
        as "the most recent one published", and on a show's page both are plausible. %1$s in the
        continue form is an already-formatted remaining time, e.g. "12 min left".
    -->
    <string name="podcast_play_newest">Play newest</string>
    <string name="podcast_play_newest_again">Play newest again</string>
    <string name="podcast_continue">Continue</string>
    <string name="podcast_continue_with_remaining">Continue · %1$s</string>

    <!-- The show description, which is clipped until asked for in full. -->
    <string name="podcast_description_expand">Show more</string>
    <string name="podcast_description_collapse">Show less</string>

    <!-- Filter chips over the episode list. -->
    <string name="podcast_filter_all">All</string>
    <string name="podcast_filter_unplayed">Unplayed</string>
    <string name="podcast_filter_in_progress">In progress</string>
    <string name="podcast_filter_downloaded">Downloaded</string>
    <string name="podcast_filter_empty_title">Nothing here</string>
    <string name="podcast_filter_empty_description">No episodes of this show match that filter.</string>
    <string name="podcast_filter_empty_action">Show all episodes</string>

    <!--
      The order toggle beside the filter chips.

      It is labelled with the order that is *on*, not with the one it would switch to, so the row
      reads as a description of the list under it. The spoken label has to say the opposite thing —
      what pressing it does — which is why there are four strings here and not two.
    -->
    <string name="podcast_sort_newest">Newest first</string>
    <string name="podcast_sort_oldest">Oldest first</string>
    <string name="podcast_sort_switch_to_oldest">Newest first; tap to list oldest first</string>
    <string name="podcast_sort_switch_to_newest">Oldest first; tap to list newest first</string>

    <!--
      Per-show settings, opened from the overflow.

      Every option that has an app-wide equivalent offers "use it" as its first chip, and names the
      current app-wide value inside that chip, so choosing an override is a comparison rather than a
      guess. New-episode notifications are the exception: there is no app-wide toggle to defer to.
    -->
    <string name="podcast_show_settings">Show settings</string>
    <string name="show_settings_title">Show settings</string>
    <string name="show_settings_speed">Playback speed</string>
    <!-- %1$s is an already-formatted rate, e.g. "1.5x". -->
    <string name="show_settings_app_speed">App speed (%1$s)</string>
    <string name="show_settings_auto_download">New episodes</string>
    <string name="show_settings_app_download_on">App setting (download)</string>
    <string name="show_settings_app_download_off">App setting (do not download)</string>
    <string name="show_settings_download_always">Always download</string>
    <string name="show_settings_download_never">Never download</string>
    <string name="show_settings_skip_intro">Skip the intro</string>
    <string name="show_settings_skip_intro_none">No intro</string>
    <plurals name="show_settings_skip_intro_seconds">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>
    <string name="show_settings_notify">Tell me about new episodes</string>
    <string name="show_settings_notify_description">A notification when a background refresh finds one. New episodes are stored and badged either way.</string>

    <!-- Announced for the hairline that marks the refresh run on entering the screen. -->
    <string name="podcast_refreshing">Checking for new episodes</string>
    <!-- The same hairline, borrowed by a rebuild, which is not the same promise. -->
    <string name="podcast_rebuilding">Reloading every episode</string>

    <string name="podcast_loading">Loading episodes</string>

    <string name="podcast_empty_title">No episodes</string>
    <!-- A playlist that reads as empty is almost always a permissions problem, not a transient
         one, so this does not suggest refreshing. -->
    <string name="podcast_empty_description_youtube">This playlist has no public videos we can read. Check that it is set to Public or Unlisted.</string>
    <string name="podcast_empty_description_rss">This feed published nothing we could read. Try refreshing.</string>
    <string name="podcast_empty_action">Refresh</string>

    <!-- Separates the parts of a row's metadata line. -->
    <string name="podcast_metadata_separator">" · "</string>

    <!--
        The reorder gesture on a YouTube show, spoken. A drag is invisible to a screen reader, so
        without these the playlist would be readable and completely unarrangeable with TalkBack on.
    -->
    <string name="podcast_move_up">Move up</string>
    <string name="podcast_move_down">Move down</string>

    <!--
        The swipe on a row, which replaced the button that used to sit on its right. One action
        with three faces, because an episode's offline copy is only ever in one of three positions:
        not here, on its way, or here. Each is also spoken as the row's accessibility action, so
        each has to read as something to do rather than as a state.
    -->
    <string name="podcast_action_download">Download</string>
    <string name="podcast_action_cancel_download">Cancel download</string>
    <!-- The download chip on the episode sheet, when there is a copy to delete. -->
    <!-- One spelling for one action: it was "Delete download" in the sheet and "Remove
         download" on the swipe, which is COPY-2's example of the drift. -->
    <string name="podcast_action_delete_download">Delete download</string>

    <!--
        The button the same swipe reveals, a tap rather than a pull. "Play next" rather than "Add to
        queue": it names where in the queue the episode lands, which is the whole difference between
        this and the queueing the downloads screen offers.
    -->
    <string name="podcast_action_play_next">Play next</string>
    <!--
        The two faces of one swipe button. Written as instructions rather than states, because the
        button is what the tap will do, not what the episode currently is; a screen reader reads the
        same words as the label.
    -->
    <string name="podcast_action_mark_played">Mark played</string>
    <string name="podcast_action_mark_unplayed">Mark unplayed</string>

    <!-- Snackbars. -->
    <plurals name="podcast_message_new_episodes">
        <item quantity="one">%1$d new episode</item>
        <item quantity="other">%1$d new episodes</item>
    </plurals>
    <string name="podcast_message_no_new_episodes">No new episodes</string>
    <!-- %1$s is the failure reason. -->
    <string name="podcast_message_refresh_failed">Couldn\'t refresh: %1$s</string>
    <!--
        A rebuild counts what the show now has rather than what arrived, so unlike a refresh there
        is no "nothing new" case: zero here means the feed published nothing at all.
    -->
    <plurals name="podcast_message_rebuilt">
        <item quantity="one">Reloaded %1$d episode</item>
        <item quantity="other">Reloaded %1$d episodes</item>
    </plurals>
    <!-- %1$s is the failure reason. Says the list survived, because that is the useful half. -->
    <string name="podcast_message_rebuild_failed">Couldn\'t reload: %1$s. Your episodes are unchanged.</string>
    <string name="podcast_message_episode_unavailable">That episode is no longer in your library</string>
    <string name="podcast_message_download_waiting_for_wifi">\"%1$s\" will download on Wi-Fi</string>
    <string name="podcast_message_downloading">Downloading \"%1$s\"</string>
    <string name="podcast_message_download_removed">Deleted \"%1$s\" from this device</string>
    <!-- %1$s is the episode's title. Says where it went, because the queue is another screen. -->
    <string name="podcast_message_queued_next">\"%1$s\" plays next</string>
    <!-- Snackbar after a mark; %1$s is the episode title. Both are offered back. -->
    <string name="podcast_message_marked_played">Marked \"%1$s\" played</string>
    <string name="podcast_message_marked_unplayed">Marked \"%1$s\" unplayed</string>
    <string name="podcast_undo">Undo</string>

    <!--
        Download and export: downloads the episodes on screen that are not on the device, then
        copies them as ordinary audio files, with a Markdown list, into a folder the user names and
        places. The menu entry changes to the running form while a run goes, so it cannot be
        started twice; %1$d is episodes done in that stage, %2$d episodes in the export.
    -->
    <string name="podcast_download_and_export">Download and export</string>
    <string name="podcast_exporting">Exporting…</string>
    <string name="podcast_export_downloading_progress">Downloading %1$d of %2$d…</string>
    <string name="podcast_exporting_progress">Exporting %1$d of %2$d…</string>
    <!-- The dialog before the folder picker. The field starts with the show's title. -->
    <string name="podcast_export_name_title">Name the folder</string>
    <string name="podcast_export_name_body">Episodes on screen are downloaded, then copied into this folder with a list of what they are. Next, pick where it goes.</string>
    <string name="podcast_export_name_label">Folder name</string>
    <string name="podcast_export_name_confirm">Choose location</string>
    <string name="podcast_export_name_cancel">Cancel</string>
    <string name="podcast_message_export_started">Started downloading and exporting to your folder</string>
    <string name="podcast_message_export_started_wifi">Exporting to your folder once episodes download on Wi-Fi</string>
    <!-- %1$d is how many of the show's episodes are now in the folder. -->
    <plurals name="podcast_message_exported">
        <item quantity="one">Exported %1$d episode</item>
        <item quantity="other">Exported %1$d episodes</item>
    </plurals>
    <!-- %1$d episodes in the folder, %2$d that could not be downloaded or copied; the plural follows %2$d. -->
    <plurals name="podcast_message_exported_with_failures">
        <item quantity="one">Exported %1$d · %2$d episode could not be exported</item>
        <item quantity="other">Exported %1$d · %2$d episodes could not be exported</item>
    </plurals>
    <string name="podcast_message_export_failed">Couldn\'t export. Try again.</string>



    <!--
        The episode sheet: an episode read rather than played.

        Its primary button says what pressing it will actually do, which depends on the episode:
        %1$s in the continue form is an already-formatted remaining time, e.g. "12 min left".
    -->
    <string name="episode_play">Play</string>
    <string name="episode_play_again">Play again</string>
    <string name="episode_continue">Continue</string>
    <string name="episode_continue_with_remaining">Continue · %1$s</string>

    <string name="episode_action_add_to_queue">Add to queue</string>
    <string name="episode_action_share">Share</string>

    <!-- Heading over the publisher's own show notes. -->
    <string name="episode_notes">Show notes</string>

    <!-- Heading over the chapter list; %1$d is how many there are. -->
    <plurals name="episode_chapters">
        <item quantity="one">%1$d chapter</item>
        <item quantity="other">%1$d chapters</item>
    </plurals>
    <!-- Spoken while the app looks for chapters, which can mean a fetch from the publisher. -->
    <string name="episode_chapters_loading">Looking for chapters</string>

    <!-- Snackbar after adding to the end of the queue; %1$s is the episode title. -->
    <string name="podcast_message_queued">\"%1$s\" added to the queue</string>
    <!-- Nothing changed, and saying "added" about a queue that looks the same reads as a loss. -->
    <string name="podcast_message_already_queued">\"%1$s\" is already in the queue</string>
    <string name="podcast_message_already_playing">\"%1$s\" is already playing</string>

    <!-- What the system share sheet is titled when an episode is shared out of the app. -->
    <string name="episode_share_title">Share episode</string>

    <!--
        The counts line under a show's title, in the same words as the library row's own line: one
        show described one way. How many episodes are on the device is not part of it — the header
        draws the downloaded mark and a number beside this line, as the row does.
    -->
    <plurals name="podcast_episode_count">
        <item quantity="one">%1$d episode</item>
        <item quantity="other">%1$d episodes</item>
    </plurals>
    <!-- "Videos" for a YouTube playlist, which is what the user called them when they added it. -->
    <plurals name="podcast_video_count">
        <item quantity="one">%1$d video</item>
        <item quantity="other">%1$d videos</item>
    </plurals>

    <!-- Handing the show itself to somebody: the two menu entries that change nothing. -->
    <string name="podcast_share_show">Share show</string>
    <string name="podcast_copy_feed">Copy feed link</string>
    <!-- What the system share sheet is titled when the show is shared out of the app. -->
    <string name="podcast_share_show_title">Share show</string>
    <!-- The clipboard entry's own name, which the system's copy confirmation displays. -->
    <string name="podcast_feed_clip_label">Feed link</string>
</resources>
