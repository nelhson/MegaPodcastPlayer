<?xml version="1.0" encoding="utf-8"?>
<!--
    Copy for the podcast detail screen.

    Every per-episode button names the episode it acts on: TalkBack reaches these out of the list's
    reading order, without the title beside them.

    The date and duration parts of a row's metadata line come from `:core:common`'s formatters,
    which still format in English; see Q-1 in docs/REFACTORING_PLAN.md.
-->
<resources>

    <string name="podcast_back">Back to the library</string>
    <string name="podcast_remove">Remove this podcast</string>
    <string name="podcast_more_actions">More actions</string>
    <string name="podcast_play_latest">Play latest</string>

    <!-- The overflow's background-refresh switch, which had no control anywhere until now. -->
    <string name="podcast_auto_refresh_on">Refreshing in the background</string>
    <string name="podcast_auto_refresh_off">Not refreshing in the background</string>

    <!-- The show description, which is clipped until asked for in full. -->
    <string name="podcast_description_expand">Show more</string>
    <string name="podcast_description_collapse">Show less</string>

    <!-- Filter chips over the episode list. -->
    <string name="podcast_filter_all">All</string>
    <string name="podcast_filter_unplayed">Unplayed</string>
    <string name="podcast_filter_in_progress">In progress</string>
    <string name="podcast_filter_downloaded">Downloaded</string>
    <string name="podcast_filter_empty_title">Nothing here</string>
    <string name="podcast_filter_empty_description">No episodes of this show match that filter.</string>
    <string name="podcast_filter_empty_action">Show all episodes</string>

    <!-- Announced for the hairline that marks the refresh run on entering the screen. -->
    <string name="podcast_refreshing">Checking for new episodes</string>

    <string name="podcast_loading">Loading episodes</string>

    <string name="podcast_empty_title">No episodes</string>
    <!-- A playlist that reads as empty is almost always a permissions problem, not a transient
         one, so this does not suggest refreshing. -->
    <string name="podcast_empty_description_youtube">This playlist has no public videos we can read. Check that it is set to Public or Unlisted.</string>
    <string name="podcast_empty_description_rss">This feed published nothing we could read. Try refreshing.</string>
    <string name="podcast_empty_action">Refresh</string>

    <!-- Separates the parts of a row's metadata line. -->
    <string name="podcast_metadata_separator">" · "</string>

    <!--
        The reorder gesture on a YouTube show, spoken. A drag is invisible to a screen reader, so
        without these the playlist would be readable and completely unarrangeable with TalkBack on.
    -->
    <string name="podcast_move_up">Move up</string>
    <string name="podcast_move_down">Move down</string>

    <!-- Snackbars. -->
    <plurals name="podcast_message_new_episodes">
        <item quantity="one">%1$d new episode</item>
        <item quantity="other">%1$d new episodes</item>
    </plurals>
    <string name="podcast_message_no_new_episodes">No new episodes</string>
    <!-- %1$s is the failure reason. -->
    <string name="podcast_message_refresh_failed">Couldn\'t refresh: %1$s</string>
    <string name="podcast_message_episode_unavailable">That episode is no longer in your library</string>
    <string name="podcast_message_download_waiting_for_wifi">\"%1$s\" will download on Wi-Fi</string>
    <string name="podcast_message_downloading">Downloading \"%1$s\"</string>
    <string name="podcast_message_download_removed">Removed \"%1$s\" from this device</string>

</resources>
