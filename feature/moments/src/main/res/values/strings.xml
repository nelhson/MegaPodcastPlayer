<?xml version="1.0" encoding="utf-8"?>
<!--
    Copy for the moments screen: the timestamped bookmarks saved while listening.

    The export wording says "with links" rather than naming a file format, because the links are the
    reason the feature exists — a moment that outlives the app is one whose document still leads
    back to the audio.
-->
<resources>

    <string name="moments_title">Moments</string>

    <string name="moments_export">Export all, with links</string>

    <string name="moments_empty_title">No moments yet</string>
    <string name="moments_empty_description">Press the bookmark button in the player — or on your watch — to keep the spot you are listening to. Every one you save turns up here.</string>

    <!-- A row's second line: the show, then the timecode. %1$s is the show, %2$s the timecode. -->
    <string name="moments_row_subtitle">%1$s · %2$s</string>
    <!-- What tapping a row does; %1$s is the timecode playback starts at. -->
    <string name="moments_row_play">Play from %1$s</string>

    <string name="moments_action_note">Edit note</string>
    <string name="moments_action_delete">Delete</string>

    <string name="moments_note_title">Note on this moment</string>
    <string name="moments_note_hint">What was said?</string>
    <string name="moments_note_save">Save</string>
    <string name="moments_note_cancel">Cancel</string>

    <string name="moments_message_deleted">Moment deleted</string>
    <string name="moments_message_undo">Undo</string>
    <string name="moments_message_exported">Moments exported</string>
    <string name="moments_message_export_failed">Could not write that file</string>
    <string name="moments_message_nothing_to_export">There are no moments to export yet</string>


    <!--
      MOM-2: the narrowing controls, which appear only once there are enough moments to need them.

      "All shows" is the chip's label when nothing is chosen rather than a word like "Show", because
      a filter chip should say what is in force and "every one of them" is an answer.
    -->
    <string name="moments_search_hint">Search notes and episodes</string>
    <string name="moments_search_clear">Clear the search</string>
    <string name="moments_filter_all_shows">All shows</string>
    <string name="moments_filter_show_description">Filter by show</string>
    <!-- %1$s is the show title, %2$d how many moments it holds. -->
    <string name="moments_filter_show_option">%1$s (%2$d)</string>
    <string name="moments_filter_group_by_show">Group by show</string>
    <string name="moments_no_matches_title">Nothing matches</string>
    <string name="moments_no_matches_description">Try fewer words, or another show.</string>

</resources>
